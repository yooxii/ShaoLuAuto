<Window x:Class="ShaoLu.Views.WindowSelectPoint"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:ResxLocalizationProvider.DefaultAssembly="ShaoLu"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        Title="{lex:Loc SelectPoint}" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="#01000000"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        KeyDown="Window_KeyDown">
    <Canvas x:Name="SelectionCanvas" 
            Background="Transparent"
            MouseMove="Canvas_MouseMove"
            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
            MouseRightButtonDown="Canvas_MouseRightButtonDown">
        <!-- 十字准星 -->
        <Line x:Name="CrossH" Stroke="#FFFF4444" StrokeThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Line x:Name="CrossV" Stroke="#FFFF4444" StrokeThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/>
        <!-- 坐标提示 -->
        <Border x:Name="PosTip" 
                Background="#CC000000" 
                CornerRadius="3" 
                Padding="5,2" 
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="PosTipText" Foreground="White" FontSize="12"/>
        </Border>
        <!-- 操作提示 -->
        <TextBlock x:Name="HintText"
                   Text="{lex:Loc SelectPointHint}"
                   Foreground="White" 
                   FontSize="16"
                   IsHitTestVisible="False"
                   Canvas.Left="10" Canvas.Top="10"/>
    </Canvas>
</Window>
