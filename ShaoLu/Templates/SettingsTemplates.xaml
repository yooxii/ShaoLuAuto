<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wd="https://github.com/WPFDevelopersOrg/WPFDevelopers"
                    xmlns:lex="http://wpflocalizeextension.codeplex.com"
                    xmlns:models="clr-namespace:ShaoLu.Models"
                    xmlns:vm="clr-namespace:ShaoLu.Viewmodels"
                    xmlns:conv="clr-namespace:ShaoLu.Converters">

    <!-- App 设置模板 -->
    <DataTemplate DataType="{x:Type vm:AppSettingsViewModel}">
        <StackPanel>
            <TextBlock Text="{lex:Loc Settings_AppSettings}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

            <!-- 字体 -->
            <Expander Header="{lex:Loc Font}" IsExpanded="True" Tag="App_Font" Margin="0,0,0,8">
                <Grid Margin="20,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{lex:Loc Font}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding Font.FontFamily, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                    </Grid>
                    
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{lex:Loc FontSize}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding Font.FontSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                    </Grid>

                    <Button Grid.Column="4" Content="..." Margin="0,4" Command="{Binding FontSelectCommand}"/>
                </Grid>
            </Expander>

            <!-- 日志 -->
            <Expander Header="{lex:Loc LogRetentionDays}" IsExpanded="True" Tag="App_Log" Margin="0,0,0,8">
                <StackPanel Margin="20,8,0,8">
                    <StackPanel Orientation="Horizontal">
                        <wd:NumericBox Value="{Binding LogRetentionDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Minimum="0" Maximum="3650" Width="80"/>
                        <TextBlock Text="{lex:Loc Settings_DaysHint}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <!-- 程序日志不跟这个设置走：固定保留一周 -->
                    <TextBlock Text="{lex:Loc ProgramLog_RetentionHint}" Margin="0,6,0,0" Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </DataTemplate>

    <!-- Step 设置模板 -->
    <DataTemplate DataType="{x:Type vm:StepSettingsViewModel}">
        <StackPanel>
            <TextBlock Text="{lex:Loc Settings_StepSettings}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

            <!-- 运行行为 -->
            <Expander Header="{lex:Loc Settings_RunBehavior}" IsExpanded="True" Tag="Step_Run" Margin="0,0,0,8">
                <Grid Margin="20,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{lex:Loc ShowErrorPopup}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShowErrorPopup}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{lex:Loc MinimizeOnRun}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding MinimizeOnRun}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{lex:Loc ConfirmBeforeRun}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ConfirmBeforeRun}"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{lex:Loc FocusWindowOnFinish}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding FocusWindowOnFinish}"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{lex:Loc CloseWindowsOnFinish}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="8" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding CloseWindowsOnFinish}"/>

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="{lex:Loc Debug_Mode}" VerticalAlignment="Center" ToolTip="{lex:Loc Debug_Mode_ToolTip}"/>
                    <CheckBox Grid.Row="10" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding DebugMode}" ToolTip="{lex:Loc Debug_Mode_ToolTip}"/>
                </Grid>
            </Expander>

            <!-- 默认参数 -->
            <Expander Header="{lex:Loc DefaultStepParams}" IsExpanded="True" Tag="Step_Params" Margin="0,0,0,8">
                <Grid Margin="20,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{lex:Loc DefaultSimilarityThreshold}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <wd:NumericBox Value="{Binding DefaultSimilarityThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                       Precision="3" Interval="0.05" Minimum="0" Maximum="1" Width="80"/>
                        <TextBlock Text="(0~1)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{lex:Loc DefaultWaitTime}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                        <wd:NumericBox Value="{Binding DefaultWaitTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                       Precision="3" Interval="0.1" Minimum="0" Width="80"/>
                        <TextBlock Text="{lex:Loc Seconds}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{lex:Loc DefaultTimeout}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                        <wd:NumericBox Value="{Binding DefaultTimeout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                       Precision="3" Interval="0.5" Minimum="0" Width="80"/>
                        <TextBlock Text="{lex:Loc Seconds}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{lex:Loc DefaultClicks}" VerticalAlignment="Center"/>
                    <wd:NumericBox Grid.Row="6" Grid.Column="1" Value="{Binding DefaultClicks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                   Minimum="1" Maximum="999" Width="80" HorizontalAlignment="Left"/>
                </Grid>
            </Expander>

            <!-- 流程图 -->
            <Expander Header="{lex:Loc Settings_FlowChart}" IsExpanded="True" Tag="Step_Flow" Margin="0,0,0,8">
                <Grid Margin="20,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{lex:Loc FlowSnapToGrid}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox IsChecked="{Binding FlowSnapToGrid}" VerticalAlignment="Center"/>
                        <TextBlock Text="{lex:Loc FlowSnapAnchors}" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <CheckBox IsChecked="{Binding FlowSnapAnchorsToGrid}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{lex:Loc FlowSpacing}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" Width="110" HorizontalAlignment="Left" VerticalAlignment="Center"
                              SelectedIndex="{Binding FlowSpacingMode, Mode=TwoWay}">
                        <ComboBoxItem Content="{lex:Loc FlowSpacingAuto}"/>
                        <ComboBoxItem Content="{lex:Loc FlowSpacingCustom}"/>
                    </ComboBox>
                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                        <wd:NumericBox Value="{Binding FlowCustomSpacing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Minimum="20" Maximum="200" Interval="2" Width="80"/>
                        <TextBlock Text="px" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="Gray"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{lex:Loc FlowBackground}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="4" Grid.Column="1" Width="110" HorizontalAlignment="Left" VerticalAlignment="Center"
                              SelectedIndex="{Binding FlowBackgroundStyle, Mode=TwoWay}">
                        <ComboBoxItem Content="{lex:Loc FlowBgDots}"/>
                        <ComboBoxItem Content="{lex:Loc FlowBgLines}"/>
                        <ComboBoxItem Content="{lex:Loc FlowBgDashed}"/>
                    </ComboBox>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{lex:Loc FlowGridSize}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="6" Grid.Column="1" Width="110" HorizontalAlignment="Left" VerticalAlignment="Center"
                              SelectedIndex="{Binding FlowGridSize, Mode=TwoWay}">
                        <ComboBoxItem Content="{lex:Loc FlowGridSmall}"/>
                        <ComboBoxItem Content="{lex:Loc FlowGridLarge}"/>
                    </ComboBox>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{lex:Loc FlowPortSpacing}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <wd:NumericBox Value="{Binding FlowPortSpacing, Mode=TwoWay}" Minimum="6" Maximum="60"
                                       Precision="0" Interval="2" Width="80"/>
                        <TextBlock Text="px" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                </Grid>
            </Expander>

            <!-- 调试选项 -->
            <Expander Header="{lex:Loc Settings_DebugSettings}" IsExpanded="True" Tag="Step_Debug" Margin="0,0,0,8">
                <Grid Margin="20,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{lex:Loc ShowOCRRegionOnRun}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShowOCRRegionOnRun}" Margin="0,0,10,0"/>
                    <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding OCRRegionOverlay.Color, UpdateSourceTrigger=LostFocus}" Width="70" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <wd:NumericBox Grid.Row="0" Grid.Column="3" Value="{Binding OCRRegionOverlay.Duration, Mode=TwoWay}" Width="60" Minimum="0.5" Maximum="30" Precision="1" Interval="0.5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{lex:Loc ShowFoundImageRegionOnRun}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShowFoundImageRegionOnRun}" Margin="0,0,10,0"/>
                    <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding FoundImageOverlay.Color, UpdateSourceTrigger=LostFocus}" Width="70" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <wd:NumericBox Grid.Row="2" Grid.Column="3" Value="{Binding FoundImageOverlay.Duration, Mode=TwoWay}" Width="60" Minimum="0.5" Maximum="30" Precision="1" Interval="0.5"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{lex:Loc ShowClickPositionOnRun}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShowClickPositionOnRun}" Margin="0,0,10,0"/>
                    <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding ClickPositionOverlay.Color, UpdateSourceTrigger=LostFocus}" Width="70" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <wd:NumericBox Grid.Row="4" Grid.Column="3" Value="{Binding ClickPositionOverlay.Duration, Mode=TwoWay}" Width="60" Minimum="0.5" Maximum="30" Precision="1" Interval="0.5"/>
                </Grid>
            </Expander>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
