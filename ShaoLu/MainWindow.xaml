<Window x:Class="ShaoLu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wd="https://github.com/WPFDevelopersOrg/WPFDevelopers"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:ResxLocalizationProvider.DefaultAssembly="ShaoLu"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        xmlns:local="clr-namespace:ShaoLu"
        xmlns:view="clr-namespace:ShaoLu.Views"
        xmlns:viewmodel="clr-namespace:ShaoLu.Viewmodels"
        xmlns:conv="clr-namespace:ShaoLu.Converters"
        xmlns:utils="clr-namespace:ShaoLu.Utils"
        d:DataContext="{d:DesignInstance Type=viewmodel:MainViewModel}"
        mc:Ignorable="d"
        PreviewKeyDown="Window_PreviewKeyDown"
        Title="{Binding WindowTitle}" Height="600" Width="1000">

    <!-- 文件操作快捷键（仅主窗口内有效） -->
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{x:Static local:MainWindow.NewCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{x:Static local:MainWindow.OpenCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{x:Static local:MainWindow.SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{x:Static local:MainWindow.SaveAsCommand}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.NewCommand}" Executed="New_Click"/>
        <CommandBinding Command="{x:Static local:MainWindow.OpenCommand}" Executed="Open_Click"/>
        <CommandBinding Command="{x:Static local:MainWindow.SaveCommand}" Executed="Save_Click"/>
        <CommandBinding Command="{x:Static local:MainWindow.SaveAsCommand}" Executed="SaveAs_Click"/>
        <CommandBinding Command="{x:Static local:MainWindow.UndoCommand}" Executed="Undo_Executed" CanExecute="Undo_CanExecute"/>
        <CommandBinding Command="{x:Static local:MainWindow.RedoCommand}" Executed="Redo_Executed" CanExecute="Redo_CanExecute"/>
    </Window.CommandBindings>
    <Window.Resources>
        <utils:SingletonLocator x:Key="VMLocator"/>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Menu>
            <MenuItem x:Name="File" Header="{lex:Loc}">
                <MenuItem x:Name="New" Header="{lex:Loc}" Click="New_Click" IsEnabled="{Binding IsLoggedIn}" InputGestureText="Ctrl+N"/>
                <MenuItem x:Name="Open" Header="{lex:Loc}" Click="Open_Click" InputGestureText="Ctrl+O"/>
                <MenuItem x:Name="Save" Header="{lex:Loc Save}" Click="Save_Click" IsEnabled="{Binding IsLoggedIn}" InputGestureText="Ctrl+S"/>
                <MenuItem x:Name="SaveAs" Header="{lex:Loc SaveAs}" Click="SaveAs_Click" IsEnabled="{Binding IsLoggedIn}" InputGestureText="Ctrl+Shift+S"/>
                <MenuItem x:Name="RecentFiles" Header="{lex:Loc RecentFiles}" SubmenuOpened="RecentFiles_SubmenuOpened"/>
            </MenuItem>
            <MenuItem x:Name="Edit" Header="{lex:Loc Edit}">
                <MenuItem x:Name="UndoMenuItem" Header="{lex:Loc Undo}" Command="{x:Static local:MainWindow.UndoCommand}" InputGestureText="Ctrl+Z"/>
                <MenuItem x:Name="RedoMenuItem" Header="{lex:Loc Redo}" Command="{x:Static local:MainWindow.RedoCommand}" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem x:Name="UndoStepEditMenuItem" Header="{lex:Loc UndoStepEdit}"
                          Command="{Binding Steps.UndoStepCommand, Source={StaticResource VMLocator}}"/>
                <MenuItem x:Name="RedoStepEditMenuItem" Header="{lex:Loc RedoStepEdit}"
                          Command="{Binding Steps.RedoStepCommand, Source={StaticResource VMLocator}}"/>
                <Separator/>
                <MenuItem Header="{lex:Loc Up}" Command="{Binding Steps.UpStepCommand, Source={StaticResource VMLocator}}"/>
                <MenuItem Header="{lex:Loc Down}" Command="{Binding Steps.DownStepCommand, Source={StaticResource VMLocator}}"/>
                <Separator/>
                <MenuItem Header="{lex:Loc Copy}" Command="{Binding Steps.CopyStepCommand, Source={StaticResource VMLocator}}"/>
                <MenuItem Header="{lex:Loc Cut}" Command="{Binding Steps.CutStepCommand, Source={StaticResource VMLocator}}"/>
                <MenuItem Header="{lex:Loc Paste}" Command="{Binding Steps.PasteStepCommand, Source={StaticResource VMLocator}}"/>
                <MenuItem Header="{lex:Loc Delete}" Command="{Binding Steps.DelStepCommand, Source={StaticResource VMLocator}}"/>
                <Separator/>
                <!-- 添加步骤：与工具栏「步骤」组同步，参数与 AddStepCommand 一致 -->
                <MenuItem x:Name="AddStepMenu" Header="{lex:Loc AddStepMenu}">
                    <MenuItem Header="{lex:Loc AddImageStep}" Command="{Binding Steps.AddStepCommand, Source={StaticResource VMLocator}}" CommandParameter="ClickImage"/>
                    <MenuItem Header="{lex:Loc AddFindImageStep}" Command="{Binding Steps.AddStepCommand, Source={StaticResource VMLocator}}" CommandParameter="FindImage"/>
                    <Separator/>
                    <MenuItem Header="{lex:Loc AddTextStep}" Command="{Binding Steps.AddStepCommand, Source={StaticResource VMLocator}}" CommandParameter="TypeText"/>
                    <MenuItem Header="{lex:Loc AddTextMoreStep}" Command="{Binding Steps.AddStepCommand, Source={StaticResource VMLocator}}" CommandParameter="TypeTextMore"/>
                    <MenuItem Header="{lex:Loc AddTextFromFileStep}" Command="{Binding Steps.AddStepCommand, Source={StaticResource VMLocator}}" CommandParameter="TypeTextFromFile"/>
                    <Separator/>
                    <MenuItem Header="{lex:Loc AddMouseActionStep}" Command="{Binding Steps.AddStepCommand, Source={StaticResource VMLocator}}" CommandParameter="MouseAction"/>
                    <MenuItem Header="{lex:Loc AddGetInputStep}" Command="{Binding Steps.AddStepCommand, Source={StaticResource VMLocator}}" CommandParameter="GetInput"/>
                    <MenuItem Header="{lex:Loc AddStatisticsStep}" Command="{Binding Steps.AddStepCommand, Source={StaticResource VMLocator}}" CommandParameter="Statistics"/>
                    <MenuItem Header="{lex:Loc AddBurnInConfigStep}" Command="{Binding Steps.AddStepCommand, Source={StaticResource VMLocator}}" CommandParameter="BurnInConfig"/>
                    <MenuItem Header="{lex:Loc AddFocusWindowStep}" Command="{Binding Steps.AddStepCommand, Source={StaticResource VMLocator}}" CommandParameter="FocusWindow"/>
                    <MenuItem Header="{lex:Loc AddEmptyStep}" Command="{Binding Steps.AddStepCommand, Source={StaticResource VMLocator}}" CommandParameter="Empty"/>
                    <MenuItem Header="{lex:Loc AddEndStep}" Command="{Binding Steps.AddStepCommand, Source={StaticResource VMLocator}}" CommandParameter="End"/>
                    <Separator/>
                    <MenuItem Header="{lex:Loc MultiThreadGroup}">
                        <MenuItem Header="{lex:Loc AddMultiThreadStep}" Command="{Binding Steps.AddStepCommand, Source={StaticResource VMLocator}}" CommandParameter="MultiThread"/>
                        <MenuItem Header="{lex:Loc AddMultiThreadEndStep}" Command="{Binding Steps.AddStepCommand, Source={StaticResource VMLocator}}" CommandParameter="MultiThreadEnd"/>
                        <MenuItem Header="{lex:Loc AddSendSignalStep}" Command="{Binding Steps.AddStepCommand, Source={StaticResource VMLocator}}" CommandParameter="SendSignal"/>
                        <MenuItem Header="{lex:Loc AddReceiveSignalStep}" Command="{Binding Steps.AddStepCommand, Source={StaticResource VMLocator}}" CommandParameter="ReceiveSignal"/>
                        <MenuItem Header="{lex:Loc AddInterruptStep}" Command="{Binding Steps.AddStepCommand, Source={StaticResource VMLocator}}" CommandParameter="Interrupt"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="{lex:Loc AddPopupStep}" Command="{Binding Steps.AddStepCommand, Source={StaticResource VMLocator}}" CommandParameter="Popup"/>
                    <MenuItem Header="{lex:Loc AddScanCodeStep}" Command="{Binding Steps.AddStepCommand, Source={StaticResource VMLocator}}" CommandParameter="ScanCode"/>
                    <MenuItem Header="{lex:Loc AddAcbelUploadStep}" Command="{Binding Steps.AddStepCommand, Source={StaticResource VMLocator}}" CommandParameter="AcbelUpload"/>
                    <MenuItem Header="{lex:Loc UserInput_StepName}" Command="{Binding Steps.AddStepCommand, Source={StaticResource VMLocator}}" CommandParameter="UserInput"/>
                </MenuItem>
            </MenuItem>
            <MenuItem x:Name="Setting" Header="{lex:Loc}" Click="Setting_Click">
            </MenuItem>
            <!-- 调试：调试模式（独立调试日志）、快速打开/清理日志、截图、识别标示开关 -->
            <MenuItem x:Name="DebugMenu" Header="{lex:Loc Menu_Debug}">
                <MenuItem x:Name="DebugModeItem" Header="{lex:Loc Debug_Mode}" IsCheckable="True"
                          IsChecked="{Binding Main.DebugMode, Source={StaticResource VMLocator}, Mode=TwoWay}"
                          ToolTip="{lex:Loc Debug_Mode_ToolTip}"/>
                <MenuItem x:Name="DebugStepOnceItem" Header="{lex:Loc Debug_StepOnce}"
                          Command="{Binding Steps.StepOnceCommand, Source={StaticResource VMLocator}}"
                          InputGestureText="F8" ToolTip="{lex:Loc Debug_StepOnce_ToolTip}"/>
                <Separator/>
                <MenuItem x:Name="DebugOpenFolderItem" Header="{lex:Loc Debug_OpenFolder}" Click="DebugOpenFolder_Click"/>
                <MenuItem x:Name="DebugOpenLatestItem" Header="{lex:Loc Debug_OpenLatest}" Click="DebugOpenLatest_Click"/>
                <MenuItem x:Name="DebugClearItem" Header="{lex:Loc Debug_Clear}" Click="DebugClear_Click"/>
                <MenuItem x:Name="DebugScreenshotItem" Header="{lex:Loc Debug_Screenshot}" Click="DebugScreenshot_Click"/>
                <Separator/>
                <MenuItem x:Name="DebugOverlayGroup" Header="{lex:Loc Debug_OverlayGroup}"
                          ToolTip="{lex:Loc Debug_OverlayGroup_ToolTip}">
                    <MenuItem x:Name="DebugShowOcrItem" Header="{lex:Loc Debug_ShowOcr}" IsCheckable="True"
                              IsChecked="{Binding Main.ShowOcrRegionOnRun, Source={StaticResource VMLocator}, Mode=TwoWay}"/>
                    <MenuItem x:Name="DebugShowFoundItem" Header="{lex:Loc Debug_ShowFound}" IsCheckable="True"
                              IsChecked="{Binding Main.ShowFoundImageOnRun, Source={StaticResource VMLocator}, Mode=TwoWay}"/>
                    <MenuItem x:Name="DebugShowClickItem" Header="{lex:Loc Debug_ShowClick}" IsCheckable="True"
                              IsChecked="{Binding Main.ShowClickPositionOnRun, Source={StaticResource VMLocator}, Mode=TwoWay}"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="DebugExecutionLogItem" Header="{lex:Loc Debug_ExecutionLog}" Click="ExecutionLog_Click"/>
            </MenuItem>
            <MenuItem x:Name="ManagementMenu" Header="{lex:Loc Management}">
                <MenuItem x:Name="LoginLogout" Header="{lex:Loc Menu_Login}" Click="LoginLogout_Click"/>
                <MenuItem x:Name="UserManagement" Header="{lex:Loc UserManagementTitle}" Click="UserManagement_Click"
                          IsEnabled="{Binding IsLoggedIn}"/>
            </MenuItem>
            <MenuItem x:Name="BurnInStatistics" Header="{lex:Loc BurnInStatistics}" Click="BurnInStatistics_Click"/>
            <!-- 扩展：OCR 引擎等以扩展形式单独发布，这里负责安装/检查/重载 -->
            <MenuItem x:Name="ExtensionMenu" Header="{lex:Loc ExtensionMenu}">
                <MenuItem x:Name="ExtStatus" Header="{lex:Loc Ext_StatusMissing}" IsEnabled="False"/>
                <Separator/>
                <MenuItem x:Name="ExtInstallFromZip" Header="{lex:Loc Ext_InstallFromZip}" Click="ExtInstall_Click" Tag="zip"/>
                <MenuItem x:Name="ExtInstallFromFolder" Header="{lex:Loc Ext_InstallFromFolder}" Click="ExtInstall_Click" Tag="folder"/>
                <Separator/>
                <MenuItem x:Name="ExtOpenFolder" Header="{lex:Loc Ext_OpenFolder}" Click="ExtOpenFolder_Click"/>
                <MenuItem x:Name="ExtRemoveOcr" Header="{lex:Loc Ext_RemoveOcr}" Click="ExtRemoveOcr_Click"/>
            </MenuItem>
            <MenuItem x:Name="Language" Header="{lex:Loc}">
                <MenuItem x:Name="English" Tag="en-US"  Header="{lex:Loc}" IsChecked="{Binding English}" Click="Language_Click"/>
                <MenuItem x:Name="SimplifiedChinese" Tag="zh-CN" Header="{lex:Loc}" IsChecked="{Binding Simplified}" Click="Language_Click"/>
                <MenuItem x:Name="TraditionalChinese" Tag="zh-TW" Header="{lex:Loc}" IsChecked="{Binding Tranditional}" Click="Language_Click"/>
            </MenuItem>
            <MenuItem x:Name="Help" Header="{lex:Loc}">
                <MenuItem x:Name="Examples" Header="{lex:Loc}"/>
                <MenuItem x:Name="UserDoc" Header="{lex:Loc}" Click="UserDoc_Click"/>
                <MenuItem x:Name="Playground" Header="{lex:Loc}" Click="Playground_Click"/>
                <MenuItem x:Name="Shortcuts" Header="{lex:Loc ShortcutList}" Click="Shortcuts_Click"/>
                <Separator/>
                <MenuItem x:Name="LogMenu" Header="{lex:Loc LogMenu}" Click="ExecutionLog_Click"/>
                <Separator/>
                <MenuItem x:Name="About" Header="{lex:Loc}" Click="About_Click"/>
            </MenuItem>
            <MenuItem x:Name="Quit" Header="{lex:Loc}" Click="Quit_Click"/>
            <!--<MenuItem Header="测试裁剪" Click="TestCrop_Click"/>-->
        </Menu> <!--菜单-->
        <view:UserControlSteps Grid.Row="1" x:Name="Steps"/>
        <!-- 状态栏：左侧当前运行步骤，右侧运行状态 -->
        <StatusBar Grid.Row="2" Height="24">
            <StatusBarItem HorizontalContentAlignment="Left">
                <TextBlock Text="{Binding Steps.CurrentRunStepName}"/>
            </StatusBarItem>
            <!-- 调试模式提醒：开着时状态栏右侧亮一个小标记，避免忘了关 -->
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{lex:Loc Debug_StatusBar}" Foreground="#FF8A4600" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Main.DebugMode, Source={StaticResource VMLocator}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding Steps.RunStateText}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
