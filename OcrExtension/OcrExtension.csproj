<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{5C4B1E77-9F3A-42D6-B0E8-1D7A6C93B012}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>ShaoLu.OcrExtension</RootNamespace>
    <AssemblyName>ShaoLu.OcrExtension</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <!-- 与主程序一致：主程序是 x64，扩展加载同一份 x64 原生库 -->
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>8.0</LangVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\x64\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <!-- 只编译期引用主程序（取 IOcrEngine 契约）：运行期主程序已经加载，不能再复制一份 exe 进扩展目录 -->
    <Reference Include="TesseractOCR">
      <HintPath>$(NuGetPackageRoot)tesseractocr\5.5.2\lib\netstandard2.0\TesseractOCR.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="TesseractOcrEngine.cs" />
    <Compile Include="TesseractOcrExtensionFactory.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OcrContract\OcrContract.csproj">
      <Project>{A72D3C41-5B98-4E27-9D14-6C0F8B7E5213}</Project>
      <Name>OcrContract</Name>
      <!-- 契约由主程序提供，扩展目录里不再放一份 -->
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <!-- 语言数据与原生库随扩展一起发布（主程序包里不再包含这些文件） -->
    <Content Include="..\ShaoLu\tessdata\*.traineddata">
      <Link>tessdata\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <!-- 只为拿到原生库（x64\tesseract55.dll / x64\leptonica-1.85.0.dll）的复制目标，托管程序集走上面的 Reference -->
    <PackageReference Include="TesseractOCR" Version="5.5.2" ExcludeAssets="compile;runtime" />
    <!-- TesseractOCR 的托管包需要 ILogger：随扩展带一份（主程序的版本不同，靠程序集版本并存避免冲突） -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions">
      <Version>10.0.3</Version>
    </PackageReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
