<Window x:Class="ShaoLu.Views.WindowUserInput"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:ResxLocalizationProvider.DefaultAssembly="ShaoLu"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        Title="{lex:Loc UserInput_Title}" Width="460" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="{lex:Loc OK}" Width="88" Height="30" Margin="0,0,8,0"
                    IsDefault="True" Click="Ok_Click"/>
            <Button Content="{lex:Loc Cancel}" Width="88" Height="30" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
        <Border x:Name="FrozenHintPanel" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="#FFF7E6" BorderBrush="#FFD591" BorderThickness="1" CornerRadius="3"
                Padding="10,8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{lex:Loc UserInput_FrozenHint}" TextWrapping="Wrap" Foreground="#8A5A00"/>
                <Button Content="{lex:Loc UserInput_LoginToEdit}" Click="Login_Click"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,3"/>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="540">
            <StackPanel x:Name="FieldsHost"/>
        </ScrollViewer>
    </DockPanel>
</Window>
