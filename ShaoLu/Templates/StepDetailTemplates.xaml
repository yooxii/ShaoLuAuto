<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:VM="clr-namespace:ShaoLu.Viewmodels"
                    xmlns:AutoVM="clr-namespace:ShaoLu.Viewmodels.AutomationStep"
                    xmlns:wd="https://github.com/WPFDevelopersOrg/WPFDevelopers"
                    xmlns:lex="http://wpflocalizeextension.codeplex.com"
                    xmlns:conv="clr-namespace:ShaoLu.Converters"
                    xmlns:models="clr-namespace:ShaoLu.Models"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <conv:ConditionModeToVisibilityConverter x:Key="ConditionModeToVisibility"/>
    <conv:ConditionEnumToStringConverter x:Key="ConditionEnumToString"/>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- 通用 Goto 跳转设置面板 -->
    <DataTemplate x:Key="GotoPanelTemplate">
        <GroupBox Header="{lex:Loc GotoPanel}" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Content="{lex:Loc StepTrueGoto}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding AllSteps}"
                          SelectedValue="{Binding TrueGotoUid, TargetNullValue={x:Static sys:Guid.Empty}}"
                          SelectedValuePath="Uid"
                          IsEditable="False"
                          MinWidth="120">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding LineNo, Mode=OneWay}"/>
                                <Run Text=" - "/>
                                <Run Text="{Binding Name, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Label Grid.Row="2" Content="{lex:Loc StepFalseGoto}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox Grid.Row="2" Grid.Column="1" 
                          ItemsSource="{Binding AllSteps}"
                          SelectedValue="{Binding FalseGotoUid, TargetNullValue={x:Static sys:Guid.Empty}}"
                          SelectedValuePath="Uid"
                          IsEditable="False"
                          MinWidth="120">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding LineNo, Mode=OneWay}"/>
                                <Run Text=" - "/>
                                <Run Text="{Binding Name, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </GroupBox>
    </DataTemplate>

    <!-- 通用条件判断面板 -->
    <DataTemplate x:Key="ConditionPanelTemplate">
        <GroupBox Header="{lex:Loc ConditionPanel}" Margin="0,10,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Label Content="{lex:Loc ConditionMode_Label}" VerticalAlignment="Center"/>
                    <ComboBox SelectedItem="{Binding ConditionMode}" MinWidth="120">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ConditionEnumToString}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <models:ConditionMode>Default</models:ConditionMode>
                        <models:ConditionMode>Custom</models:ConditionMode>
                    </ComboBox>
                </StackPanel>
                <TextBlock Text="{lex:Loc ConditionMode_Hint}" 
                           Foreground="Gray" FontSize="11" Margin="0,2,0,5" TextWrapping="Wrap"/>
                <StackPanel Visibility="{Binding ConditionMode, Converter={StaticResource ConditionModeToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Conditions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:StepCondition}">
                                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3" Padding="5" Margin="0,2">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- 第一行：引用步骤 + 变量 -->
                                        <ComboBox ItemsSource="{Binding AllSteps}"
                                                  SelectedValue="{Binding StepUid}"
                                                  SelectedValuePath="Uid"
                                                  MinWidth="80" Margin="0,0,3,3"
                                                  ToolTip="{lex:Loc Condition_StepRef_Tooltip}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <Run Text="{Binding LineNo, Mode=OneWay}"/>
                                                        <Run Text="-"/>
                                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox Grid.Column="1" 
                                                  ItemsSource="{Binding AvailableVariables}"
                                                  SelectedItem="{Binding Variable}" Margin="0,0,0,3">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource ConditionEnumToString}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <!-- 第二行：运算符 + 值 + 连接符 -->
                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                                            <ComboBox SelectedItem="{Binding Operator}" MinWidth="70" Margin="0,0,3,0">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource ConditionEnumToString}}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                                <models:ConditionOperator>Equal</models:ConditionOperator>
                                                <models:ConditionOperator>NotEqual</models:ConditionOperator>
                                                <models:ConditionOperator>GreaterThan</models:ConditionOperator>
                                                <models:ConditionOperator>LessThan</models:ConditionOperator>
                                                <models:ConditionOperator>GreaterOrEqual</models:ConditionOperator>
                                                <models:ConditionOperator>LessOrEqual</models:ConditionOperator>
                                                <models:ConditionOperator>Contains</models:ConditionOperator>
                                                <models:ConditionOperator>NotContains</models:ConditionOperator>
                                                <models:ConditionOperator>IsEmpty</models:ConditionOperator>
                                                <models:ConditionOperator>IsNotEmpty</models:ConditionOperator>
                                            </ComboBox>
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" MinWidth="50" Margin="0,0,3,0"
                                                     ToolTip="{lex:Loc Condition_Value_Tooltip}"/>
                                            <ComboBox SelectedItem="{Binding Connector}" MinWidth="55" Margin="0,0,3,0">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource ConditionEnumToString}}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                                <models:LogicConnector>And</models:LogicConnector>
                                                <models:LogicConnector>Or</models:LogicConnector>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Button Content="{lex:Loc Condition_Add}" Command="{Binding AddConditionCommand}" Margin="0,0,5,0"/>
                        <Button Content="{lex:Loc Condition_Remove}" Command="{Binding RemoveConditionCommand}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </DataTemplate>

    <!-- 识图点击步骤 -->
    <DataTemplate x:Key="ClickImageStepTemplate" DataType="{x:Type AutoVM:ClickImageStep}">
        <StackPanel>
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Select_target_pic}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding ImagePath}" IsReadOnly="True" MinWidth="120" MaxWidth="200" ToolTip="{Binding ImagePath}" VerticalAlignment="Center"/>
                <Button Content="{lex:Loc Select}" Command="{Binding SelectImageCommand}" Margin="3,0,0,0"/>
                <Button Content="{lex:Loc Edit}" Command="{Binding EditImageCommand}" Margin="3,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Picture_similarity_threshold}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding SimilarityThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Precision="3" Interval="0.001" Width="70"/>
                <Slider Value="{Binding SimilarityThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1" Width="120" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc WaitTime}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WaitTime, UpdateSourceTrigger=LostFocus}" Width="70" Precision="3" Minimum="0" Interval="0.01"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Timeout}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding Timeout, UpdateSourceTrigger=LostFocus}" Width="70" Precision="3" Minimum="0" Interval="0.1"/>
            </StackPanel>
            <GroupBox Header="{lex:Loc MouseActions}" Margin="0,5,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Button Content="+" Command="{Binding AddMouseActionCommand}" MinWidth="30" Margin="0,0,5,0"/>
                        <Button Content="-" Command="{Binding RemoveMouseActionCommand}" MinWidth="30"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding MouseActions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <ComboBox ItemsSource="{x:Static models:MouseActionItem.AllTypes}" SelectedItem="{Binding ActionType}" MinWidth="100" Margin="0,0,5,0"/>
                                    <wd:NumericBox Value="{Binding Count, Mode=TwoWay}" MinWidth="50" Minimum="1" Maximum="99" Margin="0,0,5,0"/>
                                    <wd:NumericBox Value="{Binding Interval, Mode=TwoWay}" MinWidth="60" Minimum="0" Precision="3" Interval="0.05" Margin="0,0,5,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </GroupBox>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionPanelTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- 识图查找步骤 -->
    <DataTemplate x:Key="FindImageStepTemplate" DataType="{x:Type AutoVM:FindImageStep}">
        <StackPanel>
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Select_target_pic}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding ImagePath}" IsReadOnly="True" MinWidth="120" MaxWidth="200" ToolTip="{Binding ImagePath}" VerticalAlignment="Center"/>
                <Button Content="{lex:Loc Select}" Command="{Binding SelectImageCommand}" Margin="3,0,0,0"/>
                <Button Content="{lex:Loc Edit}" Command="{Binding EditImageCommand}" Margin="3,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Picture_similarity_threshold}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding SimilarityThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Precision="3" Interval="0.001" Width="70"/>
                <Slider Value="{Binding SimilarityThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1" Width="120" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc WaitTime}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WaitTime}" Width="70" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc FindTimeInterval}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding GapTime, UpdateSourceTrigger=LostFocus}" Width="70" Minimum="0" Precision="3" Interval="0.1"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Timeout}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding Timeout, UpdateSourceTrigger=LostFocus}" Width="70" Minimum="0" Precision="3" Interval="0.1"/>
            </StackPanel>
            <StackPanel Margin="0,5,0,0" Visibility="{Binding EnableOCR, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{lex:Loc FindImage_OCR_Group}" Margin="0,0,0,2"/>
                <TextBox Text="{Binding OCRRegionText, Mode=OneWay}" IsReadOnly="True" MinWidth="180" HorizontalAlignment="Left"/>
                <TextBlock Text="{lex:Loc FindImage_OCR_Hint}" Foreground="Gray" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionPanelTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- 输入文字步骤 -->
    <DataTemplate x:Key="TextStepTemplate" DataType="{x:Type AutoVM:TypeTextStep}">
        <StackPanel>
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Type_text}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding TextToType, UpdateSourceTrigger=LostFocus}" MinWidth="150"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc WaitTime}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WaitTime}" Width="70" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc DelayBetweenKeys}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding DelayBetweenKeys, UpdateSourceTrigger=LostFocus}" Width="70" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionPanelTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- 输入文字(多)步骤 -->
    <DataTemplate x:Key="TextStepMoreTemplate" DataType="{x:Type AutoVM:TypeTextMoreStep}">
        <StackPanel>
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Prefix}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Prefix, UpdateSourceTrigger=LostFocus}" MinWidth="120"/>
                <CheckBox IsChecked="{Binding Prefix_gen}" Content="{lex:Loc AutoGen}" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Infix}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Infix, UpdateSourceTrigger=LostFocus}" MinWidth="120"/>
                <CheckBox IsChecked="{Binding Infix_gen}" Content="{lex:Loc AutoGen}" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Suffix}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Suffix, UpdateSourceTrigger=LostFocus}" MinWidth="120"/>
                <CheckBox IsChecked="{Binding Suffix_gen}" Content="{lex:Loc AutoGen}" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc WaitTime}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WaitTime}" Width="70" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc DelayBetweenKeys}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding DelayBetweenKeys, UpdateSourceTrigger=LostFocus}" Width="70" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Preview}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TextToType}" VerticalAlignment="Center"/>
            </StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionPanelTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- 从文件输入文字步骤 -->
    <DataTemplate x:Key="TextStepFromFileTemplate" DataType="{x:Type AutoVM:TypeTextFromFileStep}">
        <StackPanel>
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc WaitTime}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WaitTime}" Width="70" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc DelayBetweenKeys}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding DelayBetweenKeys}" Width="70" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,3">
                <CheckBox IsChecked="{Binding ReloadIndex}" Content="{lex:Loc ReloadIndex}" VerticalAlignment="Center"/>
                <Button Content="{lex:Loc Reset}" Command="{Binding ResetIndexCommand}" Margin="5,0,0,0"/>
            </StackPanel>
            <GroupBox Header="{lex:Loc Contents}" Margin="0,5,0,0">
                <StackPanel Margin="0,3,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Button Content="{lex:Loc Select}" Command="{Binding OpenFileCommand}" Margin="0,0,5,0"/>
                        <Button Content="+" Command="{Binding AddContentCommand}" MinWidth="30" Margin="0,0,5,0"/>
                        <Button Content="-" Command="{Binding DelContentCommand}" MinWidth="30"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Contents}" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </StackPanel>
            </GroupBox>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionPanelTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- 弹出框步骤 -->
    <DataTemplate x:Key="PopupStepTemplate" DataType="{x:Type AutoVM:PopupStep}">
        <StackPanel>
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Title}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Title, UpdateSourceTrigger=LostFocus}" MinWidth="150"/>
            </StackPanel>
            <StackPanel Margin="0,2">
                <Label Content="{lex:Loc PopupText}" Padding="0,0,0,2"/>
                <TextBox Text="{Binding PopupText, UpdateSourceTrigger=LostFocus}" Height="60" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <Button Content="{lex:Loc Font}" Command="{Binding FontSelectCommand}" Margin="0,0,5,0" Padding="10,3"/>
                    <Button Content="{lex:Loc Color}" Command="{Binding ColorSelectCommand}" Margin="0,0,5,0" Padding="10,3"/>
                    <Button Content="{lex:Loc RichTextEdit}" Command="{Binding RichTextEditCommand}" Padding="10,3"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc PopupType}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <ComboBox SelectedValue="{Binding PopupType, UpdateSourceTrigger=LostFocus}" ItemsSource="{Binding PopupTypes}" MinWidth="150">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,5,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="❓"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="Error"><Setter Property="Text" Value="❌"/></DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="Warning"><Setter Property="Text" Value="⚠️"/></DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="Information"><Setter Property="Text" Value="ℹ️"/></DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="Question"><Setter Property="Text" Value="❓"/></DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="None"><Setter Property="Text" Value=""/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <GroupBox Header="{lex:Loc Buttons}" Margin="0,5,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Button Content="+" Command="{Binding AddButtonCommand}" MinWidth="30" Margin="0,0,5,0"/>
                        <Button Content="-" Command="{Binding DelButtonCommand}" MinWidth="30"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding PopupButtons.Buttons}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type VM:PopupButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding DisplayText, UpdateSourceTrigger=LostFocus}" MinWidth="120" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <ComboBox Text="{Binding Value}" MinWidth="130" ItemsSource="{Binding DefaultValues}" IsEditable="True" VerticalAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="{lex:Loc PopupCloseMode}" Margin="0,5,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Label Content="{lex:Loc CloseMode}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding CloseModes}" SelectedItem="{Binding CloseMode}" MinWidth="150">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource ConditionEnumToString}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CloseMode}" Value="Timeout"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Label Content="{lex:Loc AutoCloseSeconds}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                        <wd:NumericBox Value="{Binding AutoCloseSeconds, Mode=TwoWay}" Minimum="0.5" Maximum="3600" Precision="1" Interval="0.5" Width="70"/>
                        <TextBlock Text="{lex:Loc Seconds}" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CloseMode}" Value="StepReached"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Label Content="{lex:Loc CloseOnStep}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding AllSteps}" SelectedValue="{Binding CloseOnStepUid, TargetNullValue={x:Static sys:Guid.Empty}}" SelectedValuePath="Uid" MinWidth="150">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock><Run Text="{Binding LineNo, Mode=OneWay}"/><Run Text=" - "/><Run Text="{Binding Name, Mode=OneWay}"/></TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionPanelTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- TextOCR 步骤 -->
    <DataTemplate x:Key="TextOCRStepTemplate" DataType="{x:Type AutoVM:TextOCRStep}">
        <StackPanel>
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc OCR_Region}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding OCRRegionText, Mode=OneWay}" IsReadOnly="True" MinWidth="150" VerticalAlignment="Center"/>
                <Button Content="{lex:Loc OCR_SelectRegion}" Command="{Binding SelectRegionCommand}" Margin="3,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc WaitTime}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WaitTime}" Width="70" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            <StackPanel Margin="0,3,0,0">
                <Button Content="{lex:Loc OCR_Test}" Command="{Binding TestOCRCommand}" HorizontalAlignment="Left"/>
                <TextBox Text="{Binding OCRResultPreview, Mode=OneWay}" IsReadOnly="True" MinHeight="40" TextWrapping="Wrap" Margin="0,3,0,0" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionPanelTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <conv:StepTemplateSelector x:Key="StepDetailSelector"
                     ClickImageTemplate="{StaticResource ClickImageStepTemplate}"
                     FindImageTemplate="{StaticResource FindImageStepTemplate}"
                     TypeTextTemplate="{StaticResource TextStepTemplate}"
                     TypeTextMoreTemplate="{StaticResource TextStepMoreTemplate}"
                     TypeTextFromFileTemplate="{StaticResource TextStepFromFileTemplate}"
                     PopupTemplate="{StaticResource PopupStepTemplate}"
                     TextOCRTemplate="{StaticResource TextOCRStepTemplate}"/>
</ResourceDictionary>