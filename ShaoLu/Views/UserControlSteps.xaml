<UserControl x:Class="ShaoLu.Views.UserControlSteps"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:lex="http://wpflocalizeextension.codeplex.com"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:wd="https://github.com/WPFDevelopersOrg/WPFDevelopers"
            lex:ResxLocalizationProvider.DefaultAssembly="ShaoLu"
            lex:ResxLocalizationProvider.DefaultDictionary="Strings"
            xmlns:local="clr-namespace:ShaoLu"
            xmlns:utils="clr-namespace:ShaoLu.Utils"
            xmlns:viewmodel="clr-namespace:ShaoLu.Viewmodels"
            xmlns:autovm="clr-namespace:ShaoLu.Viewmodels.AutomationStep"
            xmlns:models="clr-namespace:ShaoLu.Models"
            xmlns:conv="clr-namespace:ShaoLu.Converters"
            d:DataContext="{d:DesignInstance Type=viewmodel:StepsViewModel}"
            mc:Ignorable="d"
            d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:BoolToInverseBoolConverter x:Key="BoolToInverseBoolConverter"/>
            <conv:RegionCollapseConverter x:Key="RegionCollapseConverter"/>
            <utils:SingletonLocator x:Key="VMLocator" />

            <!-- 折叠开关模板只用于「多线程开始」行；其余步骤用空模板，避免绑定不存在的 IsRegionCollapsed 属性 -->
            <DataTemplate x:Key="RegionCollapseToggleTemplate">
                <ToggleButton x:Name="RegionCollapseToggle"
                              Width="16" Height="16" Padding="0" Focusable="False"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              ToolTip="{lex:Loc MultiThreadRegionCollapse_ToolTip}"
                              IsChecked="{Binding IsRegionCollapsed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Content" Value="&#x25B8;"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:StepType.MultiThread}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Content" Value="&#x25BE;"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </DataTemplate>
            <DataTemplate x:Key="RegionCollapseEmptyTemplate"/>
            <conv:RegionCollapseCellTemplateSelector x:Key="RegionCollapseCellTemplateSelector"
                                                     ToggleTemplate="{StaticResource RegionCollapseToggleTemplate}"
                                                     EmptyTemplate="{StaticResource RegionCollapseEmptyTemplate}"/>

            <ContextMenu x:Key="DataGridMenu" DataContext="{Binding Steps, Source={StaticResource VMLocator}}">
                <MenuItem Header="{lex:Loc Add}">
                    <MenuItem Header="{lex:Loc AddImageStep}" Command="{Binding AddStepCommand}" CommandParameter="ClickImage"/>
                    <MenuItem Header="{lex:Loc AddFindImageStep}" Command="{Binding AddStepCommand}" CommandParameter="FindImage"/>
                    <MenuItem Header="{lex:Loc AddTextStep}" Command="{Binding AddStepCommand}" CommandParameter="TypeText"/>
                    <MenuItem Header="{lex:Loc AddTextMoreStep}" Command="{Binding AddStepCommand}" CommandParameter="TypeTextMore"/>
                    <MenuItem Header="{lex:Loc AddTextFromFileStep}" Command="{Binding AddStepCommand}" CommandParameter="TypeTextFromFile"/>
                    <MenuItem Header="{lex:Loc AddPopupStep}" Command="{Binding AddStepCommand}" CommandParameter="Popup"/>
                    <MenuItem Header="{lex:Loc AddGetInputStep}" Command="{Binding AddStepCommand}" CommandParameter="GetInput"/>
                    <MenuItem Header="{lex:Loc AddMouseActionStep}" Command="{Binding AddStepCommand}" CommandParameter="MouseAction"/>
                    <MenuItem Header="{lex:Loc AddStatisticsStep}" Command="{Binding AddStepCommand}" CommandParameter="Statistics"/>
                    <MenuItem Header="{lex:Loc AddBurnInConfigStep}" Command="{Binding AddStepCommand}" CommandParameter="BurnInConfig"/>
                    <MenuItem Header="{lex:Loc AddFocusWindowStep}" Command="{Binding AddStepCommand}" CommandParameter="FocusWindow"/>
                    <MenuItem Header="{lex:Loc AddEmptyStep}" Command="{Binding AddStepCommand}" CommandParameter="Empty"/>
                </MenuItem>
                <MenuItem Header="{lex:Loc Delete}" Command="{Binding DelStepCommand}"/>
                <Separator/>
                <MenuItem Header="{lex:Loc Up}" Command="{Binding UpStepCommand}"/>
                <MenuItem Header="{lex:Loc Down}" Command="{Binding DownStepCommand}"/>
                <MenuItem Header="{lex:Loc Select}" Command="{Binding SelectStepCommand}"/>
                <Separator/>
                <MenuItem Header="{lex:Loc Copy}" Command="{Binding CopyStepCommand}"/>
                <MenuItem Header="{lex:Loc Cut}" Command="{Binding CutStepCommand}"/>
                <MenuItem Header="{lex:Loc Paste}" Command="{Binding PasteStepCommand}"/>
                <Separator/>
                <MenuItem Header="{lex:Loc Undo}" Command="{Binding UndoCommand}"/>
                <MenuItem Header="{lex:Loc Redo}" Command="{Binding RedoCommand}"/>
            </ContextMenu>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Templates/StepDetailTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <ToolBarPanel Margin="3">
                <ToolBarTray Orientation="Horizontal">
                    <ToolBar>
                        <Button Content="{lex:Loc BtnRun_Content}" Margin="3" Command="{Binding RunCommand}"/>
                        <Button Margin="3" Command="{Binding PauseCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Content" Value="{lex:Loc BtnPause_Content}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Content" Value="{lex:Loc BtnResume_Content}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{lex:Loc BtnStop_Content}" Margin="3" Command="{Binding StopCommand}"/>
                    </ToolBar>
                    <ToolBar Header="{lex:Loc Edit}" IsEnabled="{Binding Main.IsLoggedIn, Source={StaticResource VMLocator}}">
                        <Button Content="{lex:Loc Refresh}" Margin="3" Click="Refresh_Click"/>
                        <Button Content="{lex:Loc Undo}" Margin="3" Command="{Binding UndoCommand}"/>
                        <Button Content="{lex:Loc Redo}" Margin="3" Command="{Binding RedoCommand}"/>
                        <Button Content="{lex:Loc Up}" Margin="3" Command="{Binding UpStepCommand}"/>
                        <Button Content="{lex:Loc Down}" Margin="3" Command="{Binding DownStepCommand}"/>
                        <Button Content="{lex:Loc Copy}" Margin="3" Command="{Binding CopyStepCommand}"/>
                        <Button Content="{lex:Loc Cut}" Margin="3" Command="{Binding CutStepCommand}"/>
                        <Button Content="{lex:Loc Paste}" Margin="3" Command="{Binding PasteStepCommand}"/>
                        <Button Content="{lex:Loc Delete}" Margin="3" Command="{Binding DelStepCommand}"/>
                    </ToolBar>
                    <ToolBar Header="{lex:Loc Step}" IsEnabled="{Binding Main.IsLoggedIn, Source={StaticResource VMLocator}}">
                        <wd:SplitButton x:Name="AddImageStep" Content="{lex:Loc AddImageStep}" CommandParameter="ClickImage" Margin="3" Background="Transparent" Foreground="Black" BorderBrush="Transparent" BorderThickness="0" Click="SplitButton_Click"
                                       >
                            <MenuItem Header="{lex:Loc AddImageStep}" Click="MenuItemAddImageStep_Click" CommandParameter="ClickImage"/>
                            <MenuItem Header="{lex:Loc AddFindImageStep}" Click="MenuItemAddImageStep_Click" CommandParameter="FindImage"/>
                            <MenuItem Header="{lex:Loc AddTextStep}" Click="MenuItemAddImageStep_Click" CommandParameter="TypeText"/>
                            <MenuItem Header="{lex:Loc AddTextMoreStep}" Click="MenuItemAddImageStep_Click" CommandParameter="TypeTextMore"/>
                            <MenuItem Header="{lex:Loc AddTextFromFileStep}" Click="MenuItemAddImageStep_Click" CommandParameter="TypeTextFromFile"/>
                            <MenuItem Header="{lex:Loc AddMouseActionStep}" Click="MenuItemAddImageStep_Click" CommandParameter="MouseAction"/>
                        </wd:SplitButton>
                        <wd:SplitButton x:Name="AddOCRStep" Content="{lex:Loc AddGetInputStep}" CommandParameter="GetInput" Margin="3" Background="Transparent" Foreground="Black" BorderBrush="Transparent" BorderThickness="0" Click="SplitButton_Click">
                            <MenuItem Header="{lex:Loc AddGetInputStep}" Click="MenuItemAddOtherStep_Click" CommandParameter="GetInput"/>
                            <MenuItem Header="{lex:Loc AddStatisticsStep}" Click="MenuItemAddOtherStep_Click" CommandParameter="Statistics"/>
                            <MenuItem Header="{lex:Loc AddBurnInConfigStep}" Click="MenuItemAddOtherStep_Click" CommandParameter="BurnInConfig"/>
                            <MenuItem Header="{lex:Loc AddFocusWindowStep}" Click="MenuItemAddOtherStep_Click" CommandParameter="FocusWindow"/>
                            <MenuItem Header="{lex:Loc AddEmptyStep}" Click="MenuItemAddOtherStep_Click" CommandParameter="Empty"/>
                        </wd:SplitButton>
                        <wd:SplitButton x:Name="AddMultiThreadStep" Content="{lex:Loc MultiThreadGroup}" CommandParameter="MultiThread" Margin="3" Background="Transparent" Foreground="Black" BorderBrush="Transparent" BorderThickness="0" Click="SplitButton_Click">
                            <MenuItem Header="{lex:Loc AddMultiThreadStep}" Click="MenuItemAddOtherStep_Click" CommandParameter="MultiThread"/>
                            <MenuItem Header="{lex:Loc AddMultiThreadEndStep}" Click="MenuItemAddOtherStep_Click" CommandParameter="MultiThreadEnd"/>
                            <MenuItem Header="{lex:Loc AddSendSignalStep}" Click="MenuItemAddOtherStep_Click" CommandParameter="SendSignal"/>
                            <MenuItem Header="{lex:Loc AddReceiveSignalStep}" Click="MenuItemAddOtherStep_Click" CommandParameter="ReceiveSignal"/>
                            <MenuItem Header="{lex:Loc AddInterruptStep}" Click="MenuItemAddOtherStep_Click" CommandParameter="Interrupt"/>
                        </wd:SplitButton>
                        <Button Content="{lex:Loc AddPopupStep}" Margin="3" Command="{Binding AddStepCommand}" CommandParameter="Popup"/>
                    </ToolBar>
                </ToolBarTray>
            </ToolBarPanel>
            <!--步骤按钮-->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="400"/>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>
                <GroupBox Header="{lex:Loc StepsBox}" Margin="3">
                    <DataGrid x:Name="StepsBox" ItemsSource="{Binding AutomationStepBases}"
                              ContextMenu="{StaticResource DataGridMenu}"
                              SelectionMode="Extended" SelectedItem="{Binding SelectedStep}"
                              utils:DataGridSelectedItemsBehavior.SelectedItems="{Binding SelectedSteps}"
                              IsReadOnly="{Binding Main.IsLoggedIn, Source={StaticResource VMLocator}, Converter={StaticResource BoolToInverseBoolConverter}}">
                            <DataGrid.InputBindings>
                                <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyStepCommand}"/>
                                <KeyBinding Key="X" Modifiers="Ctrl" Command="{Binding CutStepCommand}"/>
                                <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PasteStepCommand}"/>
                                <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}"/>
                                <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}"/>
                                <KeyBinding Key="Z" Modifiers="Ctrl+Shift" Command="{Binding RedoCommand}"/>
                            </DataGrid.InputBindings>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource WD.DefaultDataGridRow}">
                                <Style.Setters>
                                    <!-- 折叠的多线程区域：区域内各行隐藏（多线程开始行与区域结束标记行始终显示） -->
                                    <Setter Property="Visibility">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource RegionCollapseConverter}">
                                                <Binding/>
                                                <Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                                <Binding Source="{x:Static autovm:RegionCollapseNotifier.Instance}" Path="Revision"/>
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Style.Setters>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Background" Value="#FFFFCCCC"/>
                                        <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderBrush" Value="Black"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- 多线程区域折叠开关：只出现在「多线程开始」行的首列 -->
                            <DataGridTemplateColumn Width="22" CanUserSort="False" CanUserResize="False"
                                                    CellTemplateSelector="{StaticResource RegionCollapseCellTemplateSelector}"/>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding IsNeed,UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="" Binding="{Binding LineNo}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="{lex:Loc StepType}" Binding="{Binding Type}" IsReadOnly="True" CanUserSort="False"/>
                            <DataGridTextColumn Header="{lex:Loc StepName}" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="120" CanUserSort="False"/>
                            <DataGridTextColumn Header="{lex:Loc StepDescription}" Binding="{Binding Description}" Width="*" CanUserSort="False"/>
                            <DataGridTextColumn Header="{lex:Loc StepTrueGoto}" Binding="{Binding TrueGotoLineNo, Mode=OneWay}" Width="*" IsReadOnly="True" CanUserSort="False"/>
                            <DataGridTextColumn Header="{lex:Loc StepFalseGoto}" Binding="{Binding FalseGotoLineNo, Mode=OneWay}" Width="*" IsReadOnly="True" CanUserSort="False"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
                <GridSplitter Grid.Column="1" Width="3" Margin="0,3,0,3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#FFDDDDDD" />
                <GroupBox Header="{lex:Loc StepDetails}" Margin="3" Grid.Column="2"
                          IsEnabled="{Binding Main.IsLoggedIn, Source={StaticResource VMLocator}}">
                <DockPanel>
                    <!-- 撤销/恢复本步骤编辑：固定在详情顶部，不随内容滚动 -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,3">
                        <Button Content="{lex:Loc Undo}" ToolTip="{lex:Loc Undo}" Command="{Binding UndoStepCommand}" Padding="10,2" Margin="0,0,3,0"/>
                        <Button Content="{lex:Loc Redo}" ToolTip="{lex:Loc Redo}" Command="{Binding RedoStepCommand}" Padding="10,2"/>
                    </StackPanel>
                    <!-- 当 SelectedStep 为 null 时，可以显示提示文本 -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch">
                        <Grid>
                            <ContentControl Content="{Binding SelectedStep}" 
                        ContentTemplateSelector="{StaticResource StepDetailSelector}" />

                            <!-- 可选：如果没有选中项，显示提示信息 -->
                            <TextBlock Text="{lex:Loc NoSelectionHint}" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            Visibility="{Binding SelectedStep, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}"/>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
                </GroupBox>
            </Grid>
            <Grid Grid.Row="2" Margin="3 0 3 5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnRun" Content="{lex:Loc}" Margin="0,3,3,3" Command="{Binding RunCommand}"/>
                <Button Grid.Column="1" Margin="0,3,3,3" Command="{Binding PauseCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource WD.DefaultButton}">
                            <Setter Property="Content" Value="{lex:Loc BtnPause_Content}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                    <Setter Property="Content" Value="{lex:Loc BtnResume_Content}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="BtnStop" Grid.Column="2" Content="{lex:Loc}" Margin="3,3,0,3" Command="{Binding StopCommand}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
