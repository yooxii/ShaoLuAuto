<Window x:Class="ShaoLu.Views.WindowTextPreview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        Title="{lex:Loc TextPreviewTitle}" Height="420" Width="600"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="PreviewTextBox"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 BorderThickness="1"
                 Padding="8"
                 FontSize="13"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CopyButton" Content="{lex:Loc Copy}" Width="80" Height="28" Margin="0,0,8,0" Click="Copy_Click"/>
            <Button Content="{lex:Loc Close}" Width="80" Height="28" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
