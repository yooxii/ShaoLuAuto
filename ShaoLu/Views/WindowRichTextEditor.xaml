<Window x:Class="ShaoLu.Views.WindowRichTextEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        Title="{lex:Loc RichTextEdit}" 
        Width="600" Height="450"
        WindowStartupLocation="CenterOwner"
        MinWidth="400" MinHeight="300">
    <DockPanel>
        <!-- 工具栏 -->
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar Band="0" BandIndex="0">
                <ToggleButton x:Name="BtnBold" Click="BtnBold_Click" ToolTip="Bold (Ctrl+B)" FontWeight="Bold">B</ToggleButton>
                <ToggleButton x:Name="BtnItalic" Click="BtnItalic_Click" ToolTip="Italic (Ctrl+I)" FontStyle="Italic">I</ToggleButton>
                <ToggleButton x:Name="BtnUnderline" Click="BtnUnderline_Click" ToolTip="Underline (Ctrl+U)">
                    <TextBlock TextDecorations="Underline">U</TextBlock>
                </ToggleButton>
                <Separator/>
                <ComboBox x:Name="CmbFontSize" Width="50" IsEditable="True" SelectedIndex="2"
                          SelectionChanged="CmbFontSize_SelectionChanged">
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="12"/>
                    <ComboBoxItem Content="14"/>
                    <ComboBoxItem Content="16"/>
                    <ComboBoxItem Content="18"/>
                    <ComboBoxItem Content="24"/>
                    <ComboBoxItem Content="36"/>
                    <ComboBoxItem Content="48"/>
                </ComboBox>
                <Button x:Name="BtnColor" Click="BtnColor_Click" ToolTip="Text Color" Padding="4,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="A" FontWeight="Bold" Margin="0,0,3,0"/>
                        <Rectangle x:Name="ColorIndicator" Width="12" Height="12" Fill="Black" Stroke="Gray" StrokeThickness="0.5"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <Button Click="BtnLeft_Click" ToolTip="Align Left">≡</Button>
                <Button Click="BtnCenter_Click" ToolTip="Align Center">≡</Button>
                <Button Click="BtnRight_Click" ToolTip="Align Right">≡</Button>
            </ToolBar>
        </ToolBarTray>

        <!-- 底部按钮 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="OK" Click="BtnOK_Click" MinWidth="70" Margin="0,0,10,0" IsDefault="True"/>
            <Button Content="{lex:Loc Cancel}" Click="BtnCancel_Click" MinWidth="70" IsCancel="True"/>
        </StackPanel>

        <!-- 编辑区 -->
        <RichTextBox x:Name="Editor" Margin="5" AcceptsReturn="True" 
                     VerticalScrollBarVisibility="Auto"
                     SelectionChanged="Editor_SelectionChanged"/>
    </DockPanel>
</Window>
