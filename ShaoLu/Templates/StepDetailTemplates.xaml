    <!-- 输入文字步骤的UI -->
    <DataTemplate x:Key="TextStepTemplate" DataType="{x:Type AutoVM:TypeTextStep}">
        <StackPanel Orientation="Vertical">
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc WaitTime}" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WaitTime}" MinWidth="200" HorizontalAlignment="Left" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc Type_text}" VerticalAlignment="Center"/>
                <TextBox Text="{Binding TextToType, UpdateSourceTrigger=LostFocus}" MinWidth="150"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc DelayBetweenKeys}" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding DelayBetweenKeys, UpdateSourceTrigger=LostFocus}" MinWidth="200" HorizontalAlignment="Left" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionPanelTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="TextStepMoreTemplate" DataType="{x:Type AutoVM:TypeTextMoreStep}">
        <StackPanel Orientation="Vertical">
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            
            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc Prefix}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding Prefix, UpdateSourceTrigger=LostFocus}" MinWidth="150"/>
                    <CheckBox IsChecked="{Binding Prefix_gen}" Content="{lex:Loc AutoGen}" Margin="5,0,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </StackPanel>
            
            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc Infix}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding Infix, UpdateSourceTrigger=LostFocus}" MinWidth="150"/>
                    <CheckBox IsChecked="{Binding Infix_gen}" Content="{lex:Loc AutoGen}" Margin="5,0,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc Suffix}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding Suffix, UpdateSourceTrigger=LostFocus}" MinWidth="150"/>
                    <CheckBox IsChecked="{Binding Suffix_gen}" Content="{lex:Loc AutoGen}" Margin="5,0,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc WaitTime}" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WaitTime}" MinWidth="200" HorizontalAlignment="Left" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            
            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc DelayBetweenKeys}" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding DelayBetweenKeys, UpdateSourceTrigger=LostFocus}" MinWidth="200" HorizontalAlignment="Left" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc Preview}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TextToType}"/>
            </StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionPanelTemplate}"/>
        </StackPanel>
    </DataTemplate>
    
    <DataTemplate x:Key="TextStepFromFileTemplate" DataType="{x:Type AutoVM:TypeTextFromFileStep}">
        <StackPanel Orientation="Vertical">
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc WaitTime}" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WaitTime}" MinWidth="200" HorizontalAlignment="Left" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc DelayBetweenKeys}" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding DelayBetweenKeys}" MinWidth="200" HorizontalAlignment="Left" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="0,5,0,5">
                <CheckBox IsChecked="{Binding ReloadIndex}" Content="{lex:Loc ReloadIndex}" HorizontalAlignment="Left"/>
                <Button Content="{lex:Loc Reset}" Command="{Binding ResetIndexCommand}" HorizontalAlignment="Right"/>
            </StackPanel>

            <GroupBox Header="{lex:Loc Contents}">
                <StackPanel VerticalAlignment="Center" Margin="0,5,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{lex:Loc Select}" Command="{Binding OpenFileCommand}" Margin="0,0,5,3"/>
                        <Button Content=" + " Command="{Binding AddContentCommand}" Margin="0,0,5,3"/>
                        <Button Content=" - " Command="{Binding DelContentCommand}" Margin="0,0,5,3"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Contents}" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </StackPanel>
            </GroupBox>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionPanelTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="PopupStepTemplate" DataType="{x:Type AutoVM:PopupStep}">
        <StackPanel>
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc Title}" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Title, UpdateSourceTrigger=LostFocus}" 
                     MinWidth="150"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc PopupText}" VerticalAlignment="Center"/>
                <TextBox Text="{Binding PopupText, UpdateSourceTrigger=LostFocus}" 
                         MinWidth="200" MinHeight="60"
                         AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,10,5"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{lex:Loc Font}" Command="{Binding FontSelectCommand}" Margin="0,0,5,0" Padding="10,3"/>
                    <Button Content="{lex:Loc Color}" Command="{Binding ColorSelectCommand}" Padding="10,3"/>
                </StackPanel>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc PopupType}" VerticalAlignment="Center"/>
                <ComboBox SelectedValue="{Binding PopupType, UpdateSourceTrigger=LostFocus}" 
                     ItemsSource="{Binding PopupTypes}"
                     MinWidth="150"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,5,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="❓"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="Error">
                                                    <Setter Property="Text" Value="❌"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="Warning">
                                                    <Setter Property="Text" Value="⚠️"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="Information">
                                                    <Setter Property="Text" Value="ℹ️"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="Question">
                                                    <Setter Property="Text" Value="❓"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="None">
                                                    <Setter Property="Text" Value=""/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <GroupBox Header="{lex:Loc Buttons}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content=" + " Command="{Binding AddButtonCommand}" Margin="0,0,10,0"/>
                        <Button Content=" - " Command="{Binding DelButtonCommand}" Margin="0,0,10,0"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding PopupButtons.Buttons}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type VM:PopupButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding DisplayText, UpdateSourceTrigger=LostFocus}" 
                                             MinWidth="120"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"/>
                                    <ComboBox Text="{Binding Value}" 
                                              MinWidth="150"
                                              ItemsSource="{Binding DefaultValues}"
                                              Margin="0,0,10,0"
                                              IsEditable="True"
                                              VerticalAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionPanelTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- TextOCR 步骤的UI -->
    <DataTemplate x:Key="TextOCRStepTemplate" DataType="{x:Type AutoVM:TextOCRStep}">
        <StackPanel Orientation="Vertical">
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel Margin="0,5,0,0">
                <Label Content="{lex:Loc OCR_Region}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding OCRRegionText, Mode=OneWay}" 
                             IsReadOnly="True" MinWidth="200" VerticalAlignment="Center"/>
                    <Button Content="{lex:Loc OCR_SelectRegion}" Command="{Binding SelectRegionCommand}" Margin="5,0,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,5,0,0">
                <Button Content="{lex:Loc OCR_Test}" Command="{Binding TestOCRCommand}" HorizontalAlignment="Left"/>
                <TextBox Text="{Binding OCRResultPreview, Mode=OneWay}" 
                         IsReadOnly="True" MinHeight="40" TextWrapping="Wrap" 
                         Margin="0,5,0,0" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
            <StackPanel Margin="0,5,0,0">
                <Label Content="{lex:Loc WaitTime}" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WaitTime}" MinWidth="200" HorizontalAlignment="Left" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionPanelTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <conv:StepTemplateSelector x:Key="StepDetailSelector"
                     ClickImageTemplate="{StaticResource ClickImageStepTemplate}"
                     FindImageTemplate="{StaticResource FindImageStepTemplate}"
                     ClickImagesTemplate="{StaticResource ClickImagesStepTemplate}"
                     FindImagesTemplate="{StaticResource FindImagesStepTemplate}"
                     TypeTextTemplate="{StaticResource TextStepTemplate}"
                     TypeTextMoreTemplate="{StaticResource TextStepMoreTemplate}"
                     TypeTextFromFileTemplate="{StaticResource TextStepFromFileTemplate}"
                     PopupTemplate="{StaticResource PopupStepTemplate}"
                     TextOCRTemplate="{StaticResource TextOCRStepTemplate}"/>
</ResourceDictionary>