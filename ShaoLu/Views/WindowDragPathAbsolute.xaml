<Window x:Class="ShaoLu.Views.WindowDragPathAbsolute"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:ResxLocalizationProvider.DefaultAssembly="ShaoLu"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        Title="DragPathAbsolute"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        KeyDown="Window_KeyDown">
    <Canvas x:Name="SelectionCanvas"
            Background="Transparent"
            MouseMove="Canvas_MouseMove"
            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
            MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
            MouseRightButtonDown="Canvas_MouseRightButtonDown">
        <!-- 已记录的移动轨迹 -->
        <Polyline x:Name="TrajectoryLine" Stroke="#FF2196F3" StrokeThickness="2" IsHitTestVisible="False"/>
        <!-- 操作按钮 -->
        <Border x:Name="ButtonBar" Background="#CC000000" CornerRadius="4" Padding="8,5"
                Canvas.Left="10" Canvas.Top="40">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ConfirmButton" Content="{lex:Loc DragPathAbs_Confirm}" MinWidth="70"
                        Click="ConfirmButton_Click" IsEnabled="False"/>
                <Button Content="{lex:Loc DragPathAbs_Cancel}" MinWidth="70" Margin="6,0,0,0"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Border>
        <!-- 操作提示 -->
        <TextBlock x:Name="HintText"
                   Text="{lex:Loc DragPathAbs_Hint}"
                   Foreground="White"
                   FontSize="16"
                   IsHitTestVisible="False"
                   Canvas.Left="10" Canvas.Top="10"/>
    </Canvas>
</Window>
