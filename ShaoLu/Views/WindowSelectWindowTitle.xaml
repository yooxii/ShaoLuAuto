<Window x:Class="ShaoLu.Views.WindowSelectWindowTitle"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:ResxLocalizationProvider.DefaultAssembly="ShaoLu"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        Title="{lex:Loc Capture_WindowTitle_Select}" Height="420" Width="480"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{lex:Loc Refresh}" Click="Refresh_Click" MinWidth="80" Margin="0,0,6,0"/>
            <Button x:Name="OkButton" Content="{lex:Loc OK}" Click="Ok_Click" MinWidth="80" Margin="0,0,6,0" IsEnabled="False"/>
            <Button Content="{lex:Loc Cancel}" Click="Cancel_Click" MinWidth="80"/>
        </StackPanel>
        <ListBox x:Name="WindowList" SelectionChanged="WindowList_SelectionChanged"/>
    </DockPanel>
</Window>
