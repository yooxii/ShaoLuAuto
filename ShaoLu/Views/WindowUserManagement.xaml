<Window x:Class="ShaoLu.Views.WindowUserManagement"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wd="https://github.com/WPFDevelopersOrg/WPFDevelopers"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:ResxLocalizationProvider.DefaultAssembly="ShaoLu"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        xmlns:vm="clr-namespace:ShaoLu.Viewmodels"
        xmlns:models="clr-namespace:ShaoLu.Models"
        d:DataContext="{d:DesignInstance Type=vm:UserManagementViewModel}"
        mc:Ignorable="d"
        Title="{lex:Loc UserManagementTitle}" Height="520" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 用户列表 -->
        <GroupBox Grid.Row="0" Header="{lex:Loc UserList}" Margin="0,0,0,10">
            <DataGrid ItemsSource="{Binding Users}"
                      SelectedItem="{Binding SelectedUser}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{lex:Loc UsernameHeader}" Binding="{Binding Username}" Width="120"/>
                    <DataGridTextColumn Header="{lex:Loc RoleHeader}" Binding="{Binding Role}" Width="80"/>
                    <DataGridTextColumn Header="{lex:Loc CreatedAtHeader}" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- 操作区 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 添加用户 -->
            <GroupBox Grid.Column="0" Header="{lex:Loc AddUser}" Margin="0,0,5,0">
                <StackPanel Margin="8">
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="{lex:Loc Login_Username}" FontSize="12"/>
                        <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="{lex:Loc Login_Password}" FontSize="12"/>
                        <PasswordBox x:Name="AddPasswordBox" Height="26" PasswordChanged="AddPasswordBox_PasswordChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="{lex:Loc RoleHeader}" FontSize="12"/>
                        <ComboBox SelectedIndex="{Binding NewRoleIndex}" Height="26">
                            <ComboBoxItem Content="{lex:Loc AdminRole}"/>
                            <ComboBoxItem Content="{lex:Loc UserRole}"/>
                        </ComboBox>
                    </StackPanel>
                    <Button Content="{lex:Loc AddUserButton}" Command="{Binding AddUserCommand}" Height="30" Margin="0,4,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- 修改密码 -->
            <GroupBox Grid.Column="1" Header="{lex:Loc ChangePasswordTitle}" Margin="5,0,0,0">
                <StackPanel Margin="8">
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="{lex:Loc SelectedUser}" FontSize="12"/>
                        <TextBox Text="{Binding SelectedUser.Username, Mode=OneWay}" IsReadOnly="True" Height="26"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="{lex:Loc OldPassword}" FontSize="12"/>
                        <PasswordBox x:Name="OldPasswordBox" Height="26" PasswordChanged="OldPasswordBox_PasswordChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="{lex:Loc NewPassword}" FontSize="12"/>
                        <PasswordBox x:Name="NewPasswordBox" Height="26" PasswordChanged="NewPasswordBox_PasswordChanged"/>
                    </StackPanel>
                    <Button Content="{lex:Loc ChangePasswordButton}" Command="{Binding ChangePasswordCommand}" Height="30" Margin="0,4,0,0"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- 底部 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="{lex:Loc DeleteUserButton}" Command="{Binding DeleteUserCommand}"
                    Width="120" Height="30" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="12" Foreground="Gray"/>
        </StackPanel>
    </Grid>
</Window>
