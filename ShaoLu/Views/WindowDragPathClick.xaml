<Window x:Class="ShaoLu.Views.WindowDragPathClick"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wd="https://github.com/WPFDevelopersOrg/WPFDevelopers"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:ResxLocalizationProvider.DefaultAssembly="ShaoLu"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        Title="{lex:Loc DragPathClick_Title}" Height="600" Width="820"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <DockPanel Margin="8">
        <!-- 工具栏：激活半径设置与清除按钮 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="{lex:Loc DragPathClick_Radius}" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <wd:NumericBox Value="{Binding Radius, Mode=TwoWay}" Width="70" Minimum="5" Maximum="100"
                           Precision="0" Interval="1" Margin="0,0,12,0"/>
            <Button Content="{lex:Loc DragPathClick_Clear}" Click="ClearTrajectories_Click" Padding="10,2"/>
        </StackPanel>
        <!-- 说明 -->
        <TextBlock DockPanel.Dock="Top" Text="{lex:Loc DragPathClick_Hint}" TextWrapping="Wrap"
                   Foreground="Gray" FontSize="11" Margin="0,0,0,6"/>
        <!-- 原图 + 点击点 + 轨迹覆盖层 -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                <Image x:Name="SourceImage" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Canvas x:Name="OverlayCanvas" Background="Transparent"
                        MouseMove="Canvas_MouseMove"
                        MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                        MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                        MouseLeave="Canvas_MouseLeave"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
