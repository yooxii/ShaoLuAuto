<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wd="https://github.com/WPFDevelopersOrg/WPFDevelopers"
                    xmlns:lex="http://wpflocalizeextension.codeplex.com"
                    xmlns:models="clr-namespace:ShaoLu.Models"
                    xmlns:vm="clr-namespace:ShaoLu.Viewmodels"
                    xmlns:conv="clr-namespace:ShaoLu.Converters">

    <!-- App 设置模板 -->
    <DataTemplate DataType="{x:Type vm:AppSettingsViewModel}">
        <StackPanel>
            <TextBlock Text="{lex:Loc Settings_AppSettings}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{lex:Loc Theme}" VerticalAlignment="Center"/>
                <ToggleButton Grid.Row="0" Grid.Column="1" IsChecked="{Binding ThemeLight}" Margin="0,4">
                </ToggleButton>

                <Grid Grid.ColumnSpan="2" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="{lex:Loc Font}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding Font.FontFamily, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                    </Grid>
                    
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{lex:Loc FontSize}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding Font.FontSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                    </Grid>

                    <Button Grid.Column="4" Content="..." Margin="0,4" Command="{Binding FontSelectCommand}"/>
                </Grid>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{lex:Loc LogRetentionDays}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <wd:NumericBox Value="{Binding LogRetentionDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                   Minimum="0" Maximum="3650" Width="80"/>
                    <TextBlock Text="{lex:Loc Settings_DaysHint}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!-- Step 设置模板 -->
    <DataTemplate DataType="{x:Type vm:StepSettingsViewModel}">
        <StackPanel>
            <TextBlock Text="{lex:Loc Settings_StepSettings}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{lex:Loc ShowErrorPopup}" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShowErrorPopup}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{lex:Loc MinimizeOnRun}" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding MinimizeOnRun}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{lex:Loc ConfirmBeforeRun}" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ConfirmBeforeRun}"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="{lex:Loc DefaultSelfReferenceLimit}" VerticalAlignment="Center"/>
                <wd:NumericBox Grid.Row="6" Grid.Column="1" Value="{Binding DefaultSelfReferenceLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                               Minimum="1" Maximum="9999" Width="80" HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Text="{lex:Loc DefaultStepParams}" 
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="10" Grid.Column="0" Text="{lex:Loc DefaultSimilarityThreshold}" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal">
                    <wd:NumericBox Value="{Binding DefaultSimilarityThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                   Precision="3" Interval="0.05" Minimum="0" Maximum="1" Width="80"/>
                    <TextBlock Text="(0~1)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                </StackPanel>

                <TextBlock Grid.Row="12" Grid.Column="0" Text="{lex:Loc DefaultWaitTime}" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal">
                    <wd:NumericBox Value="{Binding DefaultWaitTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                   Precision="3" Interval="0.1" Minimum="0" Width="80"/>
                    <TextBlock Text="秒" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                </StackPanel>

                <TextBlock Grid.Row="14" Grid.Column="0" Text="{lex:Loc DefaultTimeout}" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="14" Grid.Column="1" Orientation="Horizontal">
                    <wd:NumericBox Value="{Binding DefaultTimeout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                   Precision="3" Interval="0.5" Minimum="0" Width="80"/>
                    <TextBlock Text="秒" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                </StackPanel>

                <TextBlock Grid.Row="16" Grid.Column="0" Text="{lex:Loc DefaultClicks}" VerticalAlignment="Center"/>
                <wd:NumericBox Grid.Row="16" Grid.Column="1" Value="{Binding DefaultClicks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                               Minimum="1" Maximum="999" Width="80" HorizontalAlignment="Left"/>
            </Grid>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>