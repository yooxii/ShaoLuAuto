<Window x:Class="ShaoLu.Views.WindowScanCode"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:ResxLocalizationProvider.DefaultAssembly="ShaoLu"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        MinWidth="320" MinHeight="150"
        MaxWidth="480"
        Background="{DynamicResource WD.BackgroundBrush}"
        Title="{lex:Loc ScanCode_Title}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" Text="{lex:Loc ScanCode_Prompt}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBox x:Name="CodeBox" Grid.Row="1" FontSize="16" Padding="6,4" MinWidth="280"
                 KeyDown="CodeBox_KeyDown"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{lex:Loc OK}" MinWidth="80" Height="30" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="{lex:Loc Cancel}" MinWidth="80" Height="30" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
