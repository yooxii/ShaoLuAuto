<UserControl x:Class="ShaoLu.Views.UserControlFlow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:ResxLocalizationProvider.DefaultAssembly="ShaoLu"
             lex:ResxLocalizationProvider.DefaultDictionary="Strings"
             xmlns:nodify="https://miroiu.github.io/nodify"
             xmlns:local="clr-namespace:ShaoLu.Views"
             xmlns:conv="clr-namespace:ShaoLu.Converters"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Nodify;component/Themes/Light.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:StepTypeToBrushConverter x:Key="StepTypeBrush"/>

            <!-- 画布底色：白底 + 点阵，随编辑器视口一起平移缩放 -->
            <DrawingBrush x:Key="FlowBackdrop" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,20,20"
                          Transform="{Binding ViewportTransform, ElementName=Editor}">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#FFFFFFFF">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,20,20"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#FFDCE3EA">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <!-- 出口 / 入口圆点：T 真、F 假、R 引用、S 顺序、I 入口 -->
            <Style x:Key="FlowConnectorStyle" TargetType="{x:Type nodify:Connector}">
                <Setter Property="Anchor" Value="{Binding Anchor, Mode=OneWayToSource}"/>
                <Setter Property="IsConnected" Value="{Binding IsConnected, Mode=TwoWay}"/>
                <Setter Property="Cursor" Value="Cross"/>
                <Setter Property="ToolTip" Value="{Binding Tip}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type nodify:Connector}">
                            <Grid Width="14" Height="14" Background="Transparent">
                                <Ellipse Fill="{Binding Brush}" Stroke="White" StrokeThickness="1.5"/>
                                <TextBlock Text="{Binding Text}" FontSize="8" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 去掉 Nodify 默认 Node 的标题条：只留 左入口 | 卡片 | 右出口 -->
            <Style x:Key="FlowNodeStyle" TargetType="{x:Type nodify:Node}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type nodify:Node}">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ItemsControl Grid.Column="0" ItemsSource="{TemplateBinding Input}"
                                              ItemTemplate="{TemplateBinding InputConnectorTemplate}" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                <ItemsControl Grid.Column="2" ItemsSource="{TemplateBinding Output}"
                                              ItemTemplate="{TemplateBinding OutputConnectorTemplate}" VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 节点卡片：用 Nodify 的 Node 托管出入口，连接才能正常拖线 -->
            <DataTemplate x:Key="FlowNodeTemplate" DataType="{x:Type local:FlowNode}">
                <nodify:Node Input="{Binding Inputs}" Output="{Binding Outputs}" Header="{x:Null}" Background="Transparent"
                             Content="{Binding}" MinHeight="0">
                    <nodify:Node.InputConnectorTemplate>
                        <DataTemplate DataType="{x:Type local:FlowConnector}">
                            <nodify:Connector Style="{StaticResource FlowConnectorStyle}"/>
                        </DataTemplate>
                    </nodify:Node.InputConnectorTemplate>
                    <nodify:Node.OutputConnectorTemplate>
                        <DataTemplate DataType="{x:Type local:FlowConnector}">
                            <nodify:Connector Style="{StaticResource FlowConnectorStyle}"/>
                        </DataTemplate>
                    </nodify:Node.OutputConnectorTemplate>
                    <nodify:Node.ContentTemplate>
                        <DataTemplate DataType="{x:Type local:FlowNode}">
                            <Border x:Name="Card" Width="220" Height="96" CornerRadius="8" SnapsToDevicePixels="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FFFFFFFF"/>
                                        <Setter Property="BorderBrush" Value="#FFB7C0CA"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Step.IsNeed}" Value="False">
                                                <Setter Property="Background" Value="#FFF2F3F5"/>
                                                <Setter Property="Opacity" Value="0.75"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Step.IsError}" Value="True">
                                                <Setter Property="BorderBrush" Value="#FFE04B4B"/>
                                                <Setter Property="ToolTip" Value="{Binding Step.ErrorMessage}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=nodify:ItemContainer}}" Value="True">
                                                <Setter Property="BorderBrush" Value="#FF2B6FD6"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid Margin="8,6,8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="26"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 左侧类型色条 -->
                                    <Rectangle Width="4" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                               Margin="-8,-6,0,-6" RadiusX="2" RadiusY="2" IsHitTestVisible="False"
                                               Grid.ColumnSpan="2" Fill="{Binding Step.Type, Converter={StaticResource StepTypeBrush}}"/>

                                    <Grid Grid.Column="0" Margin="0,0,4,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" LastChildFill="True">
                                            <Border DockPanel.Dock="Left" Background="{Binding Step.Type, Converter={StaticResource StepTypeBrush}}" CornerRadius="4"
                                                    Padding="4,0" Margin="0,0,4,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Step.LineNo}" Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Step.Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#FF243444" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding Step.Description}" Margin="0,2,0,0" FontSize="10.5"
                                                   Foreground="#FF6B7885" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                        <DockPanel Grid.Row="2" LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Step.Type}" FontSize="9.5"
                                                       Foreground="{Binding Step.Type, Converter={StaticResource StepTypeBrush}}"/>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Step.ConditionSummary}" FontSize="9.5"
                                                       Foreground="#FF8A6D3B" Margin="6,0,0,0"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{lex:Loc FlowChart_SkipBadge}" FontSize="9.5" Foreground="#FFD9534F">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Step.IsNeed}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                    </Grid>

                                    <!-- 右侧：执行日志开关（「记」） -->
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Border x:Name="LogBadge" Width="16" Height="16" CornerRadius="8" Cursor="Hand"
                                                ToolTip="{lex:Loc FlowChart_LogToggle_ToolTip}"
                                                MouseLeftButtonDown="LogBadge_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FFE3E8EE"/>
                                                    <Setter Property="BorderBrush" Value="#FFC3CBD4"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Step.EnableLog}" Value="True">
                                                            <Setter Property="Background" Value="#FF7BA7E2"/>
                                                            <Setter Property="BorderBrush" Value="#FF2B6FD6"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{lex:Loc FlowChart_LogBadge}" FontSize="8.5" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="#FF243444"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </nodify:Node.ContentTemplate>
                </nodify:Node>
            </DataTemplate>        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 视图操作 -->
        <Border Grid.Row="0" Background="#FFF7F8FA" BorderBrush="#FFD5DAE0" BorderThickness="0,0,0,1" Padding="2,3">
            <WrapPanel Orientation="Horizontal">
                <Button Content="{lex:Loc FlowChart_AutoLayout}" Margin="2" Padding="8,2" Click="AutoLayout_Click"/>
                <Button Content="{lex:Loc FlowChart_FitToWindow}" Margin="2" Padding="8,2" Click="FitToWindow_Click"/>
                <Rectangle Width="1" Height="18" Fill="#FFD5DAE0" Margin="6,0"/>
                <Button Content="&#x2212;" Margin="2" Padding="8,1" Click="ZoomOut_Click"/>
                <TextBlock Text="{Binding ViewportZoom, ElementName=Editor, StringFormat={}{0:P0}}" Width="46"
                           TextAlignment="Center" VerticalAlignment="Center"/>
                <Button Content="+" Margin="2" Padding="8,1" Click="ZoomIn_Click"/>
                <Rectangle Width="1" Height="18" Fill="#FFD5DAE0" Margin="6,0"/>
                <ToggleButton x:Name="FocusModeToggle" Margin="2" Padding="8,2"
                              Content="{lex:Loc FlowChart_FocusMode}" Click="FocusMode_Click"
                              ToolTip="{lex:Loc FlowChart_FocusMode_ToolTip}"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#FFD5DAE0" BorderThickness="0,0,0,1" ClipToBounds="True">
            <Grid Background="{StaticResource FlowBackdrop}">
                <Grid Background="{StaticResource FlowBackdrop}" Panel.ZIndex="-2" IsHitTestVisible="False"/>

                <nodify:NodifyEditor x:Name="Editor"
                                     Background="Transparent"
                                     ItemsSource="{Binding Nodes}"
                                     Connections="{Binding Connections}"
                                     PendingConnection="{Binding Pending}"
                                     SelectedItems="{Binding Selection}"
                                     AllowDrop="False">
                    <nodify:NodifyEditor.ItemContainerStyle>
                        <Style TargetType="{x:Type nodify:ItemContainer}">
                            <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}"/>
                        </Style>
                    </nodify:NodifyEditor.ItemContainerStyle>

                    <nodify:NodifyEditor.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:FlowNode}">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FlowNodeTemplate}" Focusable="False"/>
                        </DataTemplate>
                    </nodify:NodifyEditor.ItemTemplate>

                    <nodify:NodifyEditor.ConnectionTemplate>
                        <DataTemplate DataType="{x:Type local:FlowEdge}">
                            <nodify:LineConnection Source="{Binding Source.Anchor}"
                                                   Target="{Binding Target.Anchor}"
                                                   Stroke="{Binding Brush}"
                                                   StrokeThickness="{Binding Thickness}"
                                                   ArrowSize="10,7" Spacing="6"
                                                   Opacity="{Binding Opacity}"/>
                        </DataTemplate>
                    </nodify:NodifyEditor.ConnectionTemplate>

                    <nodify:NodifyEditor.PendingConnectionTemplate>
                        <DataTemplate>
                            <nodify:PendingConnection StartedCommand="{Binding StartCommand}"
                                                     CompletedCommand="{Binding CompletedCommand}"
                                                     AllowOnlyConnectors="False"
                                                     EnablePreview="True"
                                                     Stroke="#FF2B6FD6"
                                                     StrokeThickness="2"
                                                     StrokeDashArray="4,3"/>
                        </DataTemplate>
                    </nodify:NodifyEditor.PendingConnectionTemplate>
                </nodify:NodifyEditor>

                <TextBlock x:Name="EmptyHint" Text="{lex:Loc FlowChart_Empty}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="#FF98A2AD" IsHitTestVisible="False"
                           Visibility="Collapsed"/>

                <!-- 全屏（窗口内铺满编辑区）：固定在画布左下角 -->
                <ToggleButton x:Name="FullscreenToggle" Panel.ZIndex="30"
                              HorizontalAlignment="Left" VerticalAlignment="Bottom"
                              Margin="10,0,0,10" Width="34" Height="34" Padding="0" Cursor="Hand"
                              ToolTip="{lex:Loc FlowChart_Fullscreen_ToolTip}"
                              Click="FullscreenToggle_Click">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="#F2FFFFFF" BorderBrush="#FFC3CBD4"
                                    BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                                <Grid>
                                    <Path x:Name="ExpandIcon" Width="16" Height="16"
                                          Data="M3,9 L3,3 L9,3 M15,3 L21,3 L21,9 M21,15 L21,21 L15,21 M9,21 L3,21 L3,15"
                                          Stretch="Uniform" Stroke="#FF243444" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Path x:Name="CollapseIcon" Width="16" Height="16" Visibility="Collapsed"
                                          Data="M9,3 L9,9 L3,9 M21,9 L15,9 L15,3 M15,21 L15,15 L21,15 M3,15 L9,15 L9,21"
                                          Stretch="Uniform" Stroke="#FF243444" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FFFFFFFF"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FF8AA0B8"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ExpandIcon" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="CollapseIcon" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Bd" Property="Background" Value="#FFEAF3FF"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FF7BA7E2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#FFF0F2F5" Padding="8,3">
            <TextBlock Text="{lex:Loc FlowChart_Hint}" FontSize="11" Foreground="#FF6B7885" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
