<Window x:Class="ShaoLu.Views.WindowExecutionLog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        xmlns:vm="clr-namespace:ShaoLu.Viewmodels"
        d:DataContext="{d:DesignInstance Type=vm:ExecutionLogViewModel}"
        mc:Ignorable="d"
        Title="{lex:Loc ExecutionLog}" Height="550" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 搜索/筛选栏 -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,10" VerticalAlignment="Center">
            <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                     MinWidth="160" Margin="0,0,8,5" VerticalContentAlignment="Center">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <ComboBox ItemsSource="{Binding FileNames}" 
                      SelectedItem="{Binding SelectedFileName}"
                      MinWidth="120" Margin="0,0,8,5" VerticalContentAlignment="Center"
                      IsEditable="False">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <DatePicker SelectedDate="{Binding DateFrom}" MinWidth="110" Margin="0,0,4,5"/>
            <TextBlock Text="~" VerticalAlignment="Center" Margin="0,0,4,5"/>
            <DatePicker SelectedDate="{Binding DateTo}" MinWidth="110" Margin="0,0,8,5"/>

            <Button Content="{lex:Loc Search}" Command="{Binding SearchCommand}" 
                    MinWidth="60" Margin="0,0,5,5" Padding="8,3"/>
            <Button Content="{lex:Loc Reset}" Command="{Binding ResetCommand}" 
                    MinWidth="60" Margin="0,0,0,5" Padding="8,3"/>
        </WrapPanel>

        <!-- 数据表格 -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Logs}" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F5F5F5"
                  Sorting="DataGrid_Sorting">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{lex:Loc ExecutedAt}" 
                                    Binding="{Binding ExecutedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" 
                                    Width="150" SortMemberPath="ExecutedAt"/>
                <DataGridTextColumn Header="{lex:Loc StepFileName}" 
                                    Binding="{Binding StepFileName}" 
                                    Width="120" SortMemberPath="StepFileName"/>
                <DataGridTextColumn Header="{lex:Loc StepName}" 
                                    Binding="{Binding StepName}" 
                                    Width="120" SortMemberPath="StepName"/>
                <DataGridTextColumn Header="UID" 
                                    Binding="{Binding StepUid}" 
                                    Width="80" SortMemberPath="StepUid"/>
                <DataGridTextColumn Header="{lex:Loc InputText}" 
                                    Binding="{Binding InputText}" 
                                    Width="*" SortMemberPath="InputText"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 分页栏 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="{lex:Loc PrevPage}" Command="{Binding PrevPageCommand}" 
                    MinWidth="70" Margin="0,0,10,0" Padding="8,3"/>
            <TextBlock VerticalAlignment="Center" Margin="0,0,10,0">
                <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                <Run Text=" / "/>
                <Run Text="{Binding TotalPages, Mode=OneWay}"/>
            </TextBlock>
            <Button Content="{lex:Loc NextPage}" Command="{Binding NextPageCommand}" 
                    MinWidth="70" Margin="0,0,20,0" Padding="8,3"/>
            <TextBlock VerticalAlignment="Center">
                <Run Text="{lex:Loc TotalRecords}"/>
                <Run Text=": "/>
                <Run Text="{Binding TotalCount, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
