    <!-- 输入文字步骤的UI -->
    <DataTemplate x:Key="TextStepTemplate" DataType="{x:Type AutoVM:TypeTextStep}">
        <StackPanel Orientation="Vertical">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="0,5,0,0">
                <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc WaitTime}" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WaitTime}" MinWidth="200" HorizontalAlignment="Left" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc Type_text}" VerticalAlignment="Center"/>
                <TextBox Text="{Binding TextToType, UpdateSourceTrigger=LostFocus}" MinWidth="150"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc DelayBetweenKeys}" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding DelayBetweenKeys, UpdateSourceTrigger=LostFocus}" MinWidth="200" HorizontalAlignment="Left" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="TextStepMoreTemplate" DataType="{x:Type AutoVM:TypeTextMoreStep}">
        <StackPanel Orientation="Vertical">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="0,5,0,0">
                <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" HorizontalAlignment="Left"/>
            </StackPanel>
            
            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc Prefix}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding Prefix, UpdateSourceTrigger=LostFocus}" MinWidth="150"/>
                    <CheckBox IsChecked="{Binding Prefix_gen}" Content="{lex:Loc AutoGen}" Margin="5,0,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </StackPanel>
            
            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc Infix}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding Infix, UpdateSourceTrigger=LostFocus}" MinWidth="150"/>
                    <CheckBox IsChecked="{Binding Infix_gen}" Content="{lex:Loc AutoGen}" Margin="5,0,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc Suffix}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding Suffix, UpdateSourceTrigger=LostFocus}" MinWidth="150"/>
                    <CheckBox IsChecked="{Binding Suffix_gen}" Content="{lex:Loc AutoGen}" Margin="5,0,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc WaitTime}" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WaitTime}" MinWidth="200" HorizontalAlignment="Left" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            
            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc DelayBetweenKeys}" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding DelayBetweenKeys, UpdateSourceTrigger=LostFocus}" MinWidth="200" HorizontalAlignment="Left" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc Preview}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TextToType}"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>
    
    <DataTemplate x:Key="TextStepFromFileTemplate" DataType="{x:Type AutoVM:TypeTextFromFileStep}">
        <StackPanel Orientation="Vertical">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="0,0,0,5">
                <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc WaitTime}" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WaitTime}" MinWidth="200" HorizontalAlignment="Left" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc DelayBetweenKeys}" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding DelayBetweenKeys}" MinWidth="200" HorizontalAlignment="Left" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="0,5,0,5">
                <CheckBox IsChecked="{Binding ReloadIndex}" Content="{lex:Loc ReloadIndex}" HorizontalAlignment="Left"/>
            </StackPanel>

            <GroupBox Header="{lex:Loc Contents}">
                <StackPanel VerticalAlignment="Center" Margin="0,5,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{lex:Loc Select}" Command="{Binding OpenFileCommand}" Margin="0,0,5,3"/>
                        <Button Content=" + " Command="{Binding AddContentCommand}" Margin="0,0,5,3"/>
                        <Button Content=" - " Command="{Binding DelContentCommand}" Margin="0,0,5,3"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Contents}" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding .}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="PopupStepTemplate" DataType="{x:Type AutoVM:PopupStep}">
        <StackPanel>
            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc Title}" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Title, UpdateSourceTrigger=LostFocus}" 
                     MinWidth="150"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc PopupText}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding PopupText, UpdateSourceTrigger=LostFocus}" 
                               MinWidth="150"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"/>
                               
                    <Button Content="{lex:Loc Font}" Command="{Binding FontSelectCommand}" Margin="3,0,0,0"/>
                    <Button Content="{lex:Loc Color}" Command="{Binding ColorSelectCommand}" Margin="3,0,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <Label Content="{lex:Loc PopupType}" VerticalAlignment="Center"/>
                <ComboBox SelectedValue="{Binding PopupType, UpdateSourceTrigger=LostFocus}" 
                     ItemsSource="{Binding PopupTypes}"
                     MinWidth="150"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,5,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="❓"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="Error">
                                                    <Setter Property="Text" Value="❌"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="Warning">
                                                    <Setter Property="Text" Value="⚠️"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="Information">
                                                    <Setter Property="Text" Value="ℹ️"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="Question">
                                                    <Setter Property="Text" Value="❓"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="None">
                                                    <Setter Property="Text" Value=""/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <GroupBox Header="{lex:Loc Buttons}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content=" + " Command="{Binding AddButtonCommand}" Margin="0,0,10,0"/>
                        <Button Content=" - " Command="{Binding DelButtonCommand}" Margin="0,0,10,0"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding PopupButtons.Buttons}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type VM:PopupButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding DisplayText, UpdateSourceTrigger=LostFocus}" 
                                             MinWidth="120"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"/>
                                    <ComboBox Text="{Binding Value}" 
                                              MinWidth="150"
                                              ItemsSource="{Binding DefaultValues}"
                                              Margin="0,0,10,0"
                                              IsEditable="True"
                                              VerticalAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>
        </StackPanel>
    </DataTemplate>

    <!-- 通用条件判断面板 -->
    <DataTemplate x:Key="ConditionPanelTemplate">
        <GroupBox Header="{lex:Loc ConditionPanel}" Margin="0,10,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Label Content="{lex:Loc ConditionMode}" VerticalAlignment="Center"/>
                    <ComboBox SelectedItem="{Binding ConditionMode}" MinWidth="120">
                        <models:ConditionMode>Default</models:ConditionMode>
                        <models:ConditionMode>Custom</models:ConditionMode>
                    </ComboBox>
                </StackPanel>
                <StackPanel Visibility="{Binding ConditionMode, Converter={StaticResource ConditionModeToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Conditions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:StepCondition}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <ComboBox SelectedItem="{Binding Variable}" MinWidth="100" Margin="0,0,3,0">
                                        <models:ConditionVariable>ConstantTrue</models:ConditionVariable>
                                        <models:ConditionVariable>ConstantFalse</models:ConditionVariable>
                                        <models:ConditionVariable>Self_IsTrue</models:ConditionVariable>
                                        <models:ConditionVariable>Self_Similarity</models:ConditionVariable>
                                        <models:ConditionVariable>Self_ExecutionTimeMs</models:ConditionVariable>
                                        <models:ConditionVariable>Self_ClickX</models:ConditionVariable>
                                        <models:ConditionVariable>Self_ClickY</models:ConditionVariable>
                                        <models:ConditionVariable>Self_OCRText</models:ConditionVariable>
                                        <models:ConditionVariable>Step_IsTrue</models:ConditionVariable>
                                        <models:ConditionVariable>Step_Similarity</models:ConditionVariable>
                                        <models:ConditionVariable>Step_ExecutionTimeMs</models:ConditionVariable>
                                        <models:ConditionVariable>Step_ClickX</models:ConditionVariable>
                                        <models:ConditionVariable>Step_ClickY</models:ConditionVariable>
                                        <models:ConditionVariable>Step_OCRText</models:ConditionVariable>
                                    </ComboBox>
                                    <wd:NumericBox Value="{Binding StepLineNo}" MinWidth="40" Minimum="0" Margin="0,0,3,0"/>
                                    <ComboBox SelectedItem="{Binding Operator}" MinWidth="60" Margin="0,0,3,0">
                                        <models:ConditionOperator>Equal</models:ConditionOperator>
                                        <models:ConditionOperator>NotEqual</models:ConditionOperator>
                                        <models:ConditionOperator>GreaterThan</models:ConditionOperator>
                                        <models:ConditionOperator>LessThan</models:ConditionOperator>
                                        <models:ConditionOperator>GreaterOrEqual</models:ConditionOperator>
                                        <models:ConditionOperator>LessOrEqual</models:ConditionOperator>
                                        <models:ConditionOperator>Contains</models:ConditionOperator>
                                        <models:ConditionOperator>NotContains</models:ConditionOperator>
                                        <models:ConditionOperator>IsEmpty</models:ConditionOperator>
                                        <models:ConditionOperator>IsNotEmpty</models:ConditionOperator>
                                    </ComboBox>
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" MinWidth="60" Margin="0,0,3,0"/>
                                    <ComboBox SelectedItem="{Binding Connector}" MinWidth="45" Margin="0,0,3,0">
                                        <models:LogicConnector>And</models:LogicConnector>
                                        <models:LogicConnector>Or</models:LogicConnector>
                                    </ComboBox>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Button Content=" + " Command="{Binding AddConditionCommand}" Margin="0,0,5,0"/>
                        <Button Content=" - " Command="{Binding RemoveConditionCommand}"/>
                    </StackPanel>
                </StackPanel>
                <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,5,0,0"/>
            </StackPanel>
        </GroupBox>
    </DataTemplate>

    <!-- TextOCR 步骤的UI -->
    <DataTemplate x:Key="TextOCRStepTemplate" DataType="{x:Type AutoVM:TextOCRStep}">
        <StackPanel Orientation="Vertical">
            <StackPanel Margin="0,5,0,0">
                <Label Content="{lex:Loc OCR_Region}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding OCRRegionText, Mode=OneWay}" 
                             IsReadOnly="True" MinWidth="200" VerticalAlignment="Center"/>
                    <Button Content="{lex:Loc OCR_SelectRegion}" Command="{Binding SelectRegionCommand}" Margin="5,0,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,5,0,0">
                <Button Content="{lex:Loc OCR_Test}" Command="{Binding TestOCRCommand}" HorizontalAlignment="Left"/>
                <TextBox Text="{Binding OCRResultPreview, Mode=OneWay}" 
                         IsReadOnly="True" MinHeight="40" TextWrapping="Wrap" 
                         Margin="0,5,0,0" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
            <StackPanel Margin="0,5,0,0">
                <Label Content="{lex:Loc WaitTime}" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WaitTime}" MinWidth="200" HorizontalAlignment="Left" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionPanelTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <conv:StepTemplateSelector x:Key="StepDetailSelector"
                     ClickImageTemplate="{StaticResource ClickImageStepTemplate}"
                     FindImageTemplate="{StaticResource FindImageStepTemplate}"
                     ClickImagesTemplate="{StaticResource ClickImagesStepTemplate}"
                     FindImagesTemplate="{StaticResource FindImagesStepTemplate}"
                     TypeTextTemplate="{StaticResource TextStepTemplate}"
                     TypeTextMoreTemplate="{StaticResource TextStepMoreTemplate}"
                     TypeTextFromFileTemplate="{StaticResource TextStepFromFileTemplate}"
                     PopupTemplate="{StaticResource PopupStepTemplate}"
                     TextOCRTemplate="{StaticResource TextOCRStepTemplate}"/>
</ResourceDictionary>