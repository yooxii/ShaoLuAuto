<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:VM="clr-namespace:ShaoLu.Viewmodels"
                    xmlns:AutoVM="clr-namespace:ShaoLu.Viewmodels.AutomationStep"
                    xmlns:wd="https://github.com/WPFDevelopersOrg/WPFDevelopers"
                    xmlns:lex="http://wpflocalizeextension.codeplex.com"
                    xmlns:conv="clr-namespace:ShaoLu.Converters"
                    xmlns:models="clr-namespace:ShaoLu.Models"
                    xmlns:views="clr-namespace:ShaoLu.Views"
                    xmlns:utils="clr-namespace:ShaoLu.Utils"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:svc="clr-namespace:ShaoLu.Services">

    <conv:ConditionModeToVisibilityConverter x:Key="ConditionModeToVisibility"/>
    <conv:ConditionEnumToStringConverter x:Key="ConditionEnumToString"/>
    <conv:BoolToInverseBoolConverter x:Key="BoolToInverse"/>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- 细横向滚动条：每个设置段内部使用，高度 6px、无箭头、圆角滑块 -->
    <ControlTemplate x:Key="ThinHorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="False" Orientation="Horizontal">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb>
                        <Thumb.Template>
                            <ControlTemplate TargetType="{x:Type Thumb}">
                                <Border Background="#FFB8B8B8" CornerRadius="3" Margin="0,1"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- 只把「横向」滚动条换成细样式；竖向滚动条保持系统默认 -->
    <Style TargetType="{x:Type ScrollBar}">
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="6"/>
                <Setter Property="MinHeight" Value="6"/>
                <Setter Property="Template" Value="{StaticResource ThinHorizontalScrollBarTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 通用 Goto 跳转设置面板 -->
    <DataTemplate x:Key="GotoPanelTemplate">
        <GroupBox Header="{lex:Loc GotoPanel}" Margin="0,10,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" views:StepScrollAssist.BubbleWheelToParent="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Content="{lex:Loc StepTrueGoto}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding AllSteps}"
                          SelectedValue="{Binding TrueGotoUid, TargetNullValue={x:Static sys:Guid.Empty}}"
                          SelectedValuePath="Uid"
                          IsEditable="False"
                          MinWidth="120">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding LineNo, Mode=OneWay}"/>
                                <Run Text=" - "/>
                                <Run Text="{Binding Name, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Label Grid.Row="2" Content="{lex:Loc StepFalseGoto}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox Grid.Row="2" Grid.Column="1" 
                          ItemsSource="{Binding AllSteps}"
                          SelectedValue="{Binding FalseGotoUid, TargetNullValue={x:Static sys:Guid.Empty}}"
                          SelectedValuePath="Uid"
                          IsEditable="False"
                          MinWidth="120">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding LineNo, Mode=OneWay}"/>
                                <Run Text=" - "/>
                                <Run Text="{Binding Name, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Label Grid.Row="4" Content="{lex:Loc SelfReferenceLimit}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                    <wd:NumericBox Value="{Binding SelfReferenceLimit, Mode=TwoWay}" Minimum="-1" Maximum="9999" Width="80"
                                   ToolTip="{lex:Loc SelfReferenceLimitHint}"/>
                    <TextBlock Text="{lex:Loc SelfReferenceLimitHint}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray" FontSize="11"/>
                </StackPanel>
            </Grid>
          </ScrollViewer>
        </GroupBox>
    </DataTemplate>

    <!-- 条件规则行模板（步骤条件面板与统计条件计数共用） -->
    <DataTemplate x:Key="ConditionRowTemplate" DataType="{x:Type models:StepCondition}">
        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3" Padding="5" Margin="0,2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 第一行：引用步骤 + 变量 -->
                <ComboBox ItemsSource="{Binding AllSteps}"
                          SelectedValue="{Binding StepUid}"
                          SelectedValuePath="Uid"
                          MinWidth="80" Margin="0,0,3,3"
                          ToolTip="{lex:Loc Condition_StepRef_Tooltip}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding LineNo, Mode=OneWay}"/>
                                <Run Text="-"/>
                                <Run Text="{Binding Name, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding AvailableVariables}"
                          SelectedItem="{Binding Variable}" Margin="0,0,0,3">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource ConditionEnumToString}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <!-- 第二行：用户输入字段名（仅变量为「引用步骤 → 用户输入字段」时显示） -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,3"
                            Visibility="{Binding ShowFieldName, Converter={StaticResource BoolToVis}}">
                    <Label Content="{lex:Loc UserInput_FieldName}" Padding="0,0,3,0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding FieldName, UpdateSourceTrigger=LostFocus}" MinWidth="90"
                             ToolTip="{lex:Loc UserInput_FieldNameHint}"/>
                </StackPanel>
                <!-- 第三行：运算符 + 值 -->
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <ComboBox SelectedItem="{Binding Operator}" MinWidth="70" Margin="0,0,3,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ConditionEnumToString}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <models:ConditionOperator>Equal</models:ConditionOperator>
                        <models:ConditionOperator>NotEqual</models:ConditionOperator>
                        <models:ConditionOperator>GreaterThan</models:ConditionOperator>
                        <models:ConditionOperator>LessThan</models:ConditionOperator>
                        <models:ConditionOperator>GreaterOrEqual</models:ConditionOperator>
                        <models:ConditionOperator>LessOrEqual</models:ConditionOperator>
                        <models:ConditionOperator>Contains</models:ConditionOperator>
                        <models:ConditionOperator>NotContains</models:ConditionOperator>
                        <models:ConditionOperator>RegexMatch</models:ConditionOperator>
                        <models:ConditionOperator>IsEmpty</models:ConditionOperator>
                        <models:ConditionOperator>IsNotEmpty</models:ConditionOperator>
                    </ComboBox>
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" MinWidth="50" Margin="0,0,3,0"
                             ToolTip="{lex:Loc Condition_Value_Tooltip}"/>
                </StackPanel>
                <!-- 第四行：识别文本提取设置（仅识别文本变量显示） -->
                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,3,0,0"
                            Visibility="{Binding ShowTextExtractSettings, Converter={StaticResource BoolToVis}}">
                    <Label Content="{lex:Loc TextExtract_Mode}" Padding="0,0,3,0" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding AllTextExtractModes}" SelectedItem="{Binding TextExtractMode}" MinWidth="90" Margin="0,0,3,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ConditionEnumToString}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Text="{Binding ExtractLines, UpdateSourceTrigger=LostFocus}" MinWidth="60" Margin="0,0,3,0"
                             VerticalAlignment="Center"
                             ToolTip="{lex:Loc TextExtract_Lines_Tooltip}"
                             Visibility="{Binding ShowExtractLines, Converter={StaticResource BoolToVis}}"/>
                    <TextBox Text="{Binding ExtractMarker, UpdateSourceTrigger=LostFocus}" MinWidth="60" Margin="0,0,3,0"
                             VerticalAlignment="Center"
                             ToolTip="{lex:Loc TextExtract_Marker_Tooltip}"
                             Visibility="{Binding ShowExtractMarker, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ShowExtractLength, Converter={StaticResource BoolToVis}}">
                        <Label Content="{lex:Loc TextExtract_Length}" Padding="0,0,3,0" VerticalAlignment="Center"/>
                        <wd:NumericBox Value="{Binding ExtractLength, Mode=TwoWay}" Width="60" Minimum="0" Maximum="99999" Precision="0" Interval="1"
                                       ToolTip="{lex:Loc TextExtract_Length_Tooltip}"/>
                        <ComboBox ItemsSource="{Binding AllExtractUnits}" SelectedItem="{Binding ExtractUnit}" MinWidth="60" Margin="3,0,0,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource ConditionEnumToString}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
                <!-- 第五行：条件合并符（保持在最后） -->
                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,3,0,0">
                    <ComboBox SelectedItem="{Binding Connector}" MinWidth="55" Margin="0,0,3,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ConditionEnumToString}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <models:LogicConnector>And</models:LogicConnector>
                        <models:LogicConnector>Or</models:LogicConnector>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- 通用条件判断面板 -->
    <DataTemplate x:Key="ConditionPanelTemplate">
        <GroupBox Header="{lex:Loc ConditionPanel}" Margin="0,10,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" views:StepScrollAssist.BubbleWheelToParent="True">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Label Content="{lex:Loc ConditionMode_Label}" VerticalAlignment="Center"/>
                    <ComboBox SelectedItem="{Binding ConditionMode}" MinWidth="120">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ConditionEnumToString}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <models:ConditionMode>Default</models:ConditionMode>
                        <models:ConditionMode>Custom</models:ConditionMode>
                    </ComboBox>
                </StackPanel>
                <TextBlock Text="{lex:Loc ConditionMode_Hint}" 
                           Foreground="Gray" FontSize="11" Margin="0,2,0,5" TextWrapping="Wrap"/>
                <StackPanel Visibility="{Binding ConditionMode, Converter={StaticResource ConditionModeToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Conditions}" ItemTemplate="{StaticResource ConditionRowTemplate}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Button Content="{lex:Loc Condition_Add}" Command="{Binding AddConditionCommand}" Margin="0,0,5,0"/>
                        <Button Content="{lex:Loc Condition_Remove}" Command="{Binding RemoveConditionCommand}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </GroupBox>
    </DataTemplate>

    <!-- 结果判断编辑入口（点击后在新窗口编辑，原位置只保留入口与摘要） -->
    <DataTemplate x:Key="ConditionEntryTemplate">
        <GroupBox Header="{lex:Loc ConditionPanel}" Margin="0,10,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" views:StepScrollAssist.BubbleWheelToParent="True">
            <StackPanel Orientation="Horizontal">
                <Button Content="{lex:Loc Condition_EditConditions}" Command="{Binding EditConditionsCommand}" Padding="10,3" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ConditionSummary}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
        </GroupBox>
    </DataTemplate>
    <!-- 空步骤（分割符/占位符/注释） -->
    <DataTemplate x:Key="EmptyStepTemplate" DataType="{x:Type AutoVM:EmptyStep}">
        <StackPanel>
            <TextBlock Text="{lex:Loc EmptyStep_Hint}" Foreground="Gray" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc EmptyStep_Comment}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}" MinWidth="240" MinHeight="54"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc WaitTime}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WaitTime}" Width="70" Minimum="0" Precision="3" Interval="0.01"/>
            </StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- 识图点击步骤 -->
    <DataTemplate x:Key="ClickImageStepTemplate" DataType="{x:Type AutoVM:ClickImageStep}">
        <StackPanel>
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Select_target_pic}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding ImagePath}" IsReadOnly="True" MinWidth="120" MaxWidth="200" ToolTip="{Binding ImagePath}" VerticalAlignment="Center"/>
                <Button Content="{lex:Loc Select}" Command="{Binding SelectImageCommand}" Margin="3,0,0,0"/>
                <Button Content="{lex:Loc Edit}" Command="{Binding EditImageCommand}" Margin="3,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Capture}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <Button Content="{lex:Loc Capture_FullScreen}" Command="{Binding CaptureFullScreenCommand}" Margin="0,0,3,0" Padding="8,2"/>
                <Button Content="{lex:Loc Capture_Window}" Command="{Binding CaptureWindowCommand}" Margin="0,0,3,0" Padding="8,2"/>
                <Button Content="{lex:Loc Capture_Region}" Command="{Binding CaptureRegionCommand}" Padding="8,2"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Picture_similarity_threshold}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding SimilarityThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Precision="3" Interval="0.001" Width="70"/>
                <Slider Value="{Binding SimilarityThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1" Width="120" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox IsChecked="{Binding HighPrecision}" Content="{lex:Loc HighPrecision}" ToolTip="{lex:Loc HighPrecision_Hint}" Margin="0,2"/>
            <StackPanel Orientation="Horizontal" Margin="0,2" Visibility="{Binding HighPrecision, Converter={StaticResource BoolToVis}}">
                <Label Content="{lex:Loc ColorThreshold}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding ColorThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Precision="3" Interval="0.001" Width="70"/>
                <Slider Value="{Binding ColorThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1" Width="120" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc WaitTime}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WaitTime, UpdateSourceTrigger=LostFocus}" Width="70" Precision="3" Minimum="0" Interval="0.01"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Timeout}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding Timeout, UpdateSourceTrigger=LostFocus}" Width="70" Precision="3" Minimum="0" Interval="0.1"/>
            </StackPanel>
            <GroupBox Header="{lex:Loc MouseActions}" Margin="0,5,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" views:StepScrollAssist.BubbleWheelToParent="True">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Button Content="+" Command="{Binding AddMouseActionCommand}" MinWidth="30" Margin="0,0,5,0"/>
                        <Button Content="-" Command="{Binding RemoveMouseActionCommand}" MinWidth="30"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding MouseActions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <ComboBox ItemsSource="{x:Static models:MouseActionItem.AllTypes}" SelectedItem="{Binding ActionType}" MinWidth="100" Margin="0,0,5,0" ToolTip="{lex:Loc MouseActionTypeHint}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource ConditionEnumToString}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <wd:NumericBox Value="{Binding Count, Mode=TwoWay}" MinWidth="50" Minimum="0" Maximum="99" Margin="0,0,5,0" ToolTip="{lex:Loc MouseActionCountHint}"/>
                                    <wd:NumericBox Value="{Binding Interval, Mode=TwoWay}" MinWidth="60" Minimum="0" Precision="3" Interval="0.05" Margin="0,0,5,0" ToolTip="{lex:Loc ClickIntervalHint}"/>
                                    <!-- 拖拽路径编辑按钮（仅 Drag 动作显示） -->
                                    <Button Content="{lex:Loc MouseAction_EditDragPath}" Margin="5,0,0,0" Padding="6,1"
                                            Command="{Binding DataContext.EditDragPathCommand, RelativeSource={RelativeSource AncestorType=GroupBox}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource WD.DefaultButton}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActionType}" Value="{x:Static models:MouseActionType.Drag}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </GroupBox>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionEntryTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- 识图查找步骤 -->
    <DataTemplate x:Key="FindImageStepTemplate" DataType="{x:Type AutoVM:FindImageStep}">
        <StackPanel>
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Select_target_pic}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding ImagePath}" IsReadOnly="True" MinWidth="120" MaxWidth="200" ToolTip="{Binding ImagePath}" VerticalAlignment="Center"/>
                <Button Content="{lex:Loc Select}" Command="{Binding SelectImageCommand}" Margin="3,0,0,0"/>
                <Button Content="{lex:Loc Edit}" Command="{Binding EditImageCommand}" Margin="3,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Capture}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <Button Content="{lex:Loc Capture_FullScreen}" Command="{Binding CaptureFullScreenCommand}" Margin="0,0,3,0" Padding="8,2"/>
                <Button Content="{lex:Loc Capture_Window}" Command="{Binding CaptureWindowCommand}" Margin="0,0,3,0" Padding="8,2"/>
                <Button Content="{lex:Loc Capture_Region}" Command="{Binding CaptureRegionCommand}" Padding="8,2"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Picture_similarity_threshold}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding SimilarityThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Precision="3" Interval="0.001" Width="70"/>
                <Slider Value="{Binding SimilarityThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1" Width="120" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox IsChecked="{Binding HighPrecision}" Content="{lex:Loc HighPrecision}" ToolTip="{lex:Loc HighPrecision_Hint}" Margin="0,2"/>
            <StackPanel Orientation="Horizontal" Margin="0,2" Visibility="{Binding HighPrecision, Converter={StaticResource BoolToVis}}">
                <Label Content="{lex:Loc ColorThreshold}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding ColorThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Precision="3" Interval="0.001" Width="70"/>
                <Slider Value="{Binding ColorThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1" Width="120" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc WaitTime}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WaitTime}" Width="70" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc FindTimeInterval}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding GapTime, UpdateSourceTrigger=LostFocus}" Width="70" Minimum="0" Precision="3" Interval="0.1"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Timeout}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding Timeout, UpdateSourceTrigger=LostFocus}" Width="70" Minimum="0" Precision="3" Interval="0.1"/>
            </StackPanel>
            <StackPanel Margin="0,5,0,0" Visibility="{Binding EnableOCR, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{lex:Loc FindImage_OCR_Group}" Margin="0,0,0,2"/>
                <TextBox Text="{Binding OCRRegionText, Mode=OneWay}" IsReadOnly="True" MinWidth="180" HorizontalAlignment="Left"/>
                <TextBlock Text="{lex:Loc FindImage_OCR_Hint}" Foreground="Gray" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionEntryTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- 输入文字步骤 -->
    <DataTemplate x:Key="TextStepTemplate" DataType="{x:Type AutoVM:TypeTextStep}">
        <StackPanel>
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Type_text}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding TextToType, UpdateSourceTrigger=LostFocus}" MinWidth="150"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc WaitTime}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WaitTime}" Width="70" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc DelayBetweenKeys}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding DelayBetweenKeys, UpdateSourceTrigger=LostFocus}" Width="70" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionEntryTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- 输入文字(多)步骤 -->
    <DataTemplate x:Key="TextStepMoreTemplate" DataType="{x:Type AutoVM:TypeTextMoreStep}">
        <StackPanel>
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Prefix}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Prefix, UpdateSourceTrigger=LostFocus}" MinWidth="120"/>
                <CheckBox IsChecked="{Binding Prefix_gen}" Content="{lex:Loc AutoGen}" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Infix}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Infix, UpdateSourceTrigger=LostFocus}" MinWidth="120"/>
                <CheckBox IsChecked="{Binding Infix_gen}" Content="{lex:Loc AutoGen}" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Suffix}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Suffix, UpdateSourceTrigger=LostFocus}" MinWidth="120"/>
                <CheckBox IsChecked="{Binding Suffix_gen}" Content="{lex:Loc AutoGen}" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc WaitTime}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WaitTime}" Width="70" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc DelayBetweenKeys}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding DelayBetweenKeys, UpdateSourceTrigger=LostFocus}" Width="70" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Preview}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TextToType}" VerticalAlignment="Center"/>
            </StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionEntryTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- 从文件输入文字步骤 -->
    <DataTemplate x:Key="TextStepFromFileTemplate" DataType="{x:Type AutoVM:TypeTextFromFileStep}">
        <StackPanel>
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc WaitTime}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WaitTime}" Width="70" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc DelayBetweenKeys}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding DelayBetweenKeys}" Width="70" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,3">
                <CheckBox IsChecked="{Binding ReloadIndex}" Content="{lex:Loc ReloadIndex}" VerticalAlignment="Center"/>
                <Button Content="{lex:Loc Reset}" Command="{Binding ResetIndexCommand}" Margin="5,0,0,0"/>
            </StackPanel>
            <GroupBox Header="{lex:Loc Contents}" Margin="0,5,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" views:StepScrollAssist.BubbleWheelToParent="True">
                <StackPanel Margin="0,3,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Button Content="{lex:Loc Select}" Command="{Binding OpenFileCommand}" Margin="0,0,5,0"/>
                        <Button Content="+" Command="{Binding AddContentCommand}" MinWidth="30" Margin="0,0,5,0"/>
                        <Button Content="-" Command="{Binding DelContentCommand}" MinWidth="30"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Contents}" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </StackPanel>
              </ScrollViewer>
            </GroupBox>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionEntryTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- 弹出框步骤 -->
    <DataTemplate x:Key="PopupStepTemplate" DataType="{x:Type AutoVM:PopupStep}">
        <StackPanel>
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Title}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Title, UpdateSourceTrigger=LostFocus}" MinWidth="150"/>
            </StackPanel>
            <StackPanel Margin="0,2">
                <Label Content="{lex:Loc PopupText}" Padding="0,0,0,2"/>
                <TextBox Text="{Binding PopupText, UpdateSourceTrigger=LostFocus}" Height="60" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <Button Content="{lex:Loc Font}" Command="{Binding FontSelectCommand}" Margin="0,0,5,0" Padding="10,3"/>
                    <Button Content="{lex:Loc Color}" Command="{Binding ColorSelectCommand}" Margin="0,0,5,0" Padding="10,3"/>
                    <Button Content="{lex:Loc RichTextEdit}" Command="{Binding RichTextEditCommand}" Padding="10,3"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc PopupType}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <ComboBox SelectedValue="{Binding PopupType, UpdateSourceTrigger=LostFocus}" ItemsSource="{Binding PopupTypes}" MinWidth="150">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,5,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="❓"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="Error"><Setter Property="Text" Value="❌"/></DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="Warning"><Setter Property="Text" Value="⚠️"/></DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="Information"><Setter Property="Text" Value="ℹ️"/></DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="Question"><Setter Property="Text" Value="❓"/></DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="None"><Setter Property="Text" Value=""/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc PopupWindowStyle}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding PopupWindowStyles}" SelectedItem="{Binding PopupWindowStyle}" MinWidth="150">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource ConditionEnumToString}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowPositionRelative}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Label Content="{lex:Loc PopupWindowPos}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <Label Content="X:" Padding="0,0,3,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WindowX, Mode=TwoWay}" Width="60" Precision="0" Margin="0,0,5,0"/>
                <Label Content="Y:" Padding="0,0,3,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WindowY, Mode=TwoWay}" Width="60" Precision="0" Margin="0,0,5,0"/>
                <Button Content="{lex:Loc SelectPoint}" Command="{Binding SelectPositionCommand}"/>
            </StackPanel>
            <!-- 屏幕相对坐标：按主屏宽/高的百分比（0~100），两位小数 -->
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowPositionRelative}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Label Content="{lex:Loc PopupWindowPos}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <Label Content="X:" Padding="0,0,3,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WindowX, Mode=TwoWay}" Width="60" Precision="2" Interval="0.01" Margin="0,0,5,0"/>
                <Label Content="Y:" Padding="0,0,3,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WindowY, Mode=TwoWay}" Width="60" Precision="2" Interval="0.01" Margin="0,0,5,0"/>
                <Button Content="{lex:Loc SelectPoint}" Command="{Binding SelectPositionCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <CheckBox IsChecked="{Binding WindowPositionRelative}" Content="{lex:Loc Coordinate_ScreenRelative}" ToolTip="{lex:Loc Coordinate_ScreenRelative_Hint}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc PopupOpacity}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <Slider Value="{Binding WindowOpacity, Mode=TwoWay}" Minimum="1" Maximum="100" Width="120" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WindowOpacity, Mode=TwoWay}" Width="60" Minimum="1" Maximum="100" Precision="0" Margin="5,0,0,0"/>
                <TextBlock Text="%" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc PopupBgColor}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <Border Width="22" Height="22" BorderBrush="Gray" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,5,0">
                    <Rectangle>
                        <Rectangle.Fill>
                            <SolidColorBrush Color="{Binding BackgroundColor}"/>
                        </Rectangle.Fill>
                    </Rectangle>
                </Border>
                <TextBox Text="{Binding BackgroundColor, UpdateSourceTrigger=LostFocus}" Width="80" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <Button Content="{lex:Loc Select}" Command="{Binding SelectBackgroundColorCommand}"/>
            </StackPanel>
            <GroupBox Header="{lex:Loc Buttons}" Margin="0,5,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" views:StepScrollAssist.BubbleWheelToParent="True">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Button Content="+" Command="{Binding AddButtonCommand}" MinWidth="30" Margin="0,0,5,0"/>
                        <Button Content="-" Command="{Binding DelButtonCommand}" MinWidth="30"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding PopupButtons.Buttons}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type VM:PopupButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding DisplayText, UpdateSourceTrigger=LostFocus}" MinWidth="120" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <ComboBox Text="{Binding Value}" MinWidth="130" ItemsSource="{Binding DefaultValues}" IsEditable="True" VerticalAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
              </ScrollViewer>
            </GroupBox>
            <GroupBox Header="{lex:Loc PopupCloseMode}" Margin="0,5,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" views:StepScrollAssist.BubbleWheelToParent="True">
                <StackPanel>
                    <TextBlock Text="{lex:Loc CloseMode_Hint}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <CheckBox Content="{lex:Loc CloseMode_ButtonClick}" IsChecked="{Binding CloseByButtonClick}" Margin="0,2"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <CheckBox Content="{lex:Loc CloseMode_Timeout}" IsChecked="{Binding CloseByTimeout}" VerticalAlignment="Center"/>
                        <wd:NumericBox Value="{Binding AutoCloseSeconds, Mode=TwoWay}" Minimum="0.5" Maximum="3600" Precision="1" Interval="0.5" Width="70" Margin="10,0,0,0"
                                       IsEnabled="{Binding CloseByTimeout}"/>
                        <TextBlock Text="{lex:Loc Seconds}" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <CheckBox Content="{lex:Loc CloseMode_StepReached}" IsChecked="{Binding CloseByStepReached}" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding AllSteps}" SelectedValue="{Binding CloseOnStepUid, TargetNullValue={x:Static sys:Guid.Empty}}" SelectedValuePath="Uid" MinWidth="150" Margin="10,0,0,0"
                                  IsEnabled="{Binding CloseByStepReached}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock><Run Text="{Binding LineNo, Mode=OneWay}"/><Run Text=" - "/><Run Text="{Binding Name, Mode=OneWay}"/></TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </GroupBox>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionEntryTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- 获取输入步骤 -->
    <DataTemplate x:Key="GetInputStepTemplate" DataType="{x:Type AutoVM:GetInputStep}">
        <StackPanel>
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc InputMode}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding InputModes}" SelectedItem="{Binding InputMode}" MinWidth="150">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource ConditionEnumToString}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <!-- OCR 模式配置 -->
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding InputMode}" Value="OCR"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Label Content="{lex:Loc OCR_Region}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding OCRRegionText, Mode=OneWay}" IsReadOnly="True" MinWidth="150" VerticalAlignment="Center"/>
                <Button Content="{lex:Loc OCR_SelectRegion}" Command="{Binding SelectRegionCommand}" Margin="3,0,0,0"/>
            </StackPanel>
            <!-- ScreenText 模式配置：文本获取点列表（按顺序获取，结果换行合并） -->
            <StackPanel Margin="0,2">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding InputMode}" Value="ScreenText"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                    <Label Content="{lex:Loc InputTextPoint}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                    <Button Content="+" Command="{Binding AddTextPointCommand}" MinWidth="30"/>
                </StackPanel>
                <TextBlock Text="{lex:Loc Input_TextPointsHint}" Foreground="Gray" FontSize="11" Margin="0,0,0,3" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding TextPoints}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" MinWidth="110" Margin="0,0,5,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ConditionEnumToString}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <!-- 绝对坐标：X/Y + 点选 -->
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source}" Value="{x:Static models:TextPointSource.Absolute}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <wd:NumericBox Value="{Binding X, Mode=TwoWay}" Width="65" Precision="0" Interval="1" Margin="0,0,3,0"/>
                                    <wd:NumericBox Value="{Binding Y, Mode=TwoWay}" Width="65" Precision="0" Interval="1" Margin="0,0,5,0"/>
                                    <Button Content="{lex:Loc SelectPoint}" Command="{Binding DataContext.SelectTextPointCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                </StackPanel>
                                <!-- 屏幕相对坐标：按主屏宽/高的百分比（0~100），两位小数 -->
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source}" Value="{x:Static models:TextPointSource.ScreenRelative}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <wd:NumericBox Value="{Binding X, Mode=TwoWay}" Width="65" Precision="2" Interval="0.01" Margin="0,0,3,0"/>
                                    <wd:NumericBox Value="{Binding Y, Mode=TwoWay}" Width="65" Precision="2" Interval="0.01" Margin="0,0,5,0"/>
                                    <Button Content="{lex:Loc SelectPoint}" Command="{Binding DataContext.SelectTextPointCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                </StackPanel>
                                <!-- 相对定位：状态摘要 + 选图 + 编辑 -->
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source}" Value="{x:Static models:TextPointSource.Relative}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBox Text="{Binding Summary, Mode=OneWay}" IsReadOnly="True" MinWidth="100" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <Button Content="{lex:Loc Select}" Command="{Binding DataContext.SelectPointImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="0,0,3,0"/>
                                    <Button Content="{lex:Loc Edit}" Command="{Binding DataContext.EditPointImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                </StackPanel>
                                <Button Content="{lex:Loc Delete}" Margin="5,0,0,0" Command="{Binding DataContext.RemoveTextPointCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc WaitTime}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WaitTime}" Width="70" Minimum="0" Precision="3" Interval="0.001"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Timeout}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding Timeout, UpdateSourceTrigger=LostFocus}" Width="70" Minimum="0" Precision="3" Interval="0.1"/>
            </StackPanel>
            <StackPanel Margin="0,3,0,0">
                <Button Content="{lex:Loc OCR_Test}" Command="{Binding TestOCRCommand}" HorizontalAlignment="Left"/>
                <!-- 结果预览：超过100字符截断显示，点击预览全文 -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="2" MinHeight="40" Margin="0,3,0,0"
                        Background="#FAFAFA" Cursor="Hand" ToolTip="{lex:Loc ClickToPreview}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding PreviewResultCommand}"/>
                    </Border.InputBindings>
                    <TextBlock Text="{Binding OCRResultPreview, Mode=OneWay}" TextWrapping="Wrap" Padding="5"/>
                </Border>
            </StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionEntryTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- 鼠标操作步骤 -->
    <DataTemplate x:Key="MouseActionStepTemplate" DataType="{x:Type AutoVM:MouseActionStep}">
        <StackPanel>
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc PositionMode}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding PositionModes}" SelectedItem="{Binding PositionMode}" MinWidth="120">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource ConditionEnumToString}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PositionMode}" Value="Absolute"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Label Content="X:" Padding="0,0,3,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding TargetX, Mode=TwoWay}" Width="70" Precision="0" Margin="0,0,5,0"/>
                <Label Content="Y:" Padding="0,0,3,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding TargetY, Mode=TwoWay}" Width="70" Precision="0" Margin="0,0,5,0"/>
                <Button Content="{lex:Loc SelectPoint}" Command="{Binding SelectPositionCommand}"/>
            </StackPanel>
            <!-- 屏幕相对坐标：按主屏宽/高的百分比（0~100），两位小数 -->
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PositionMode}" Value="Relative"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Label Content="X:" Padding="0,0,3,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding TargetX, Mode=TwoWay}" Width="70" Precision="2" Interval="0.01" Margin="0,0,5,0"/>
                <Label Content="Y:" Padding="0,0,3,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding TargetY, Mode=TwoWay}" Width="70" Precision="2" Interval="0.01" Margin="0,0,5,0"/>
                <Button Content="{lex:Loc SelectPoint}" Command="{Binding SelectPositionCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc WaitTime}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WaitTime}" Width="70" Minimum="0" Precision="3" Interval="0.01"/>
            </StackPanel>
            <GroupBox Header="{lex:Loc MouseActions}" Margin="0,5,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" views:StepScrollAssist.BubbleWheelToParent="True">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Button Content="+" Command="{Binding AddMouseActionCommand}" MinWidth="30" Margin="0,0,5,0"/>
                        <Button Content="-" Command="{Binding RemoveMouseActionCommand}" MinWidth="30"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding MouseActions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <ComboBox ItemsSource="{x:Static models:MouseActionItem.AllTypes}" SelectedItem="{Binding ActionType}" MinWidth="100" Margin="0,0,5,0" ToolTip="{lex:Loc MouseActionTypeHint}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource ConditionEnumToString}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <wd:NumericBox Value="{Binding Count, Mode=TwoWay}" MinWidth="50" Minimum="0" Maximum="99" Margin="0,0,5,0" ToolTip="{lex:Loc MouseActionCountHint}"/>
                                    <wd:NumericBox Value="{Binding Interval, Mode=TwoWay}" MinWidth="60" Minimum="0" Precision="3" Interval="0.05" Margin="0,0,5,0" ToolTip="{lex:Loc ClickIntervalHint}"/>
                                    <!-- 拖拽路径编辑按钮（仅 Drag 动作显示） -->
                                    <Button Content="{lex:Loc MouseAction_EditDragPath}" Margin="5,0,0,0" Padding="6,1"
                                            Command="{Binding DataContext.EditDragPathCommand, RelativeSource={RelativeSource AncestorType=GroupBox}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActionType}" Value="{x:Static models:MouseActionType.Drag}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </GroupBox>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionEntryTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- 统计项行模板（默认统计项与自定义条件共用） -->
    <DataTemplate x:Key="StatsItemTemplate">
        <StackPanel Margin="0,2">
            <CheckBox IsChecked="{Binding IsEnabled}" Content="{Binding DisplayName}"/>
            <!-- 自定义条件：重命名 + 删除 -->
            <StackPanel Orientation="Horizontal" Margin="18,2,0,0"
                        Visibility="{Binding ShowConditionSettings, Converter={StaticResource BoolToVis}}">
                <Label Content="{lex:Loc StatsItemName}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding CustomName, UpdateSourceTrigger=LostFocus}" MinWidth="120" Margin="0,0,5,0"/>
                <Button Content="{lex:Loc Delete}"
                        Command="{Binding DataContext.RemoveCustomConditionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"/>
            </StackPanel>
            <!-- 范围子设置 -->
            <StackPanel Orientation="Horizontal" Margin="18,2,0,0"
                        Visibility="{Binding ShowScopeSettings, Converter={StaticResource BoolToVis}}">
                <Label Content="{lex:Loc StatsScope}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding AllScopes}" SelectedItem="{Binding Scope}" MinWidth="120">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource ConditionEnumToString}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <!-- 自选步骤列表 -->
            <ListBox Margin="18,2,0,0" MaxHeight="120"
                     SelectionMode="Extended"
                     ItemsSource="{Binding DataContext.AllSteps, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                     utils:ListBoxSelectedUidsBehavior.SelectedUids="{Binding CustomStepUids}"
                     Visibility="{Binding ShowCustomList, Converter={StaticResource BoolToVis}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding LineNo, Mode=OneWay}"/>
                            <Run Text=" - "/>
                            <Run Text="{Binding Name, Mode=OneWay}"/>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!-- 自定义条件：判断条件编辑 -->
            <StackPanel Margin="18,2,0,0"
                        Visibility="{Binding ShowConditionSettings, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Conditions}" ItemTemplate="{StaticResource ConditionRowTemplate}"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <Button Content="{lex:Loc Condition_Add}" Command="{Binding AddConditionCommand}" Margin="0,0,5,0"/>
                    <Button Content="{lex:Loc Condition_Remove}" Command="{Binding RemoveConditionCommand}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- 统计信息步骤 -->
    <DataTemplate x:Key="StatisticsStepTemplate" DataType="{x:Type AutoVM:StatisticsStep}">
        <StackPanel>
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc StatsWindowTitle}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding WindowTitle, UpdateSourceTrigger=LostFocus}" MinWidth="120"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowPositionRelative}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Label Content="{lex:Loc StatsWindowPos}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <Label Content="X:" Padding="0,0,3,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WindowX, Mode=TwoWay}" Width="60" Precision="0" Margin="0,0,5,0"/>
                <Label Content="Y:" Padding="0,0,3,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WindowY, Mode=TwoWay}" Width="60" Precision="0" Margin="0,0,5,0"/>
                <Button Content="{lex:Loc SelectPoint}" Command="{Binding SelectWindowPositionCommand}"/>
            </StackPanel>
            <!-- 屏幕相对坐标：按主屏宽/高的百分比（0~100），两位小数 -->
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowPositionRelative}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Label Content="{lex:Loc StatsWindowPos}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <Label Content="X:" Padding="0,0,3,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WindowX, Mode=TwoWay}" Width="60" Precision="2" Interval="0.01" Margin="0,0,5,0"/>
                <Label Content="Y:" Padding="0,0,3,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WindowY, Mode=TwoWay}" Width="60" Precision="2" Interval="0.01" Margin="0,0,5,0"/>
                <Button Content="{lex:Loc SelectPoint}" Command="{Binding SelectWindowPositionCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <CheckBox IsChecked="{Binding WindowPositionRelative}" Content="{lex:Loc Coordinate_ScreenRelative}" ToolTip="{lex:Loc Coordinate_ScreenRelative_Hint}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <CheckBox IsChecked="{Binding AlwaysOnTop}" Content="{lex:Loc StatsAlwaysOnTop}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <CheckBox IsChecked="{Binding CloseOnStop}" Content="{lex:Loc StatsCloseOnStop}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc StatsAutoClose}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding AutoCloseSeconds, Mode=TwoWay}" Width="70" Minimum="0" Precision="1" Interval="1"/>
                <TextBlock Text="{lex:Loc Seconds}" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Gray"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc PopupBgColor}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <Border Width="22" Height="22" BorderBrush="Gray" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,5,0">
                    <Rectangle>
                        <Rectangle.Fill>
                            <SolidColorBrush Color="{Binding BackgroundColor}"/>
                        </Rectangle.Fill>
                    </Rectangle>
                </Border>
                <TextBox Text="{Binding BackgroundColor, UpdateSourceTrigger=LostFocus}" Width="80" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <Button Content="{lex:Loc Select}" Command="{Binding SelectBackgroundColorCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc PopupOpacity}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <Slider Value="{Binding BackgroundOpacity, Mode=TwoWay}" Minimum="1" Maximum="100" Width="120" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding BackgroundOpacity, Mode=TwoWay}" Width="60" Minimum="1" Maximum="100" Precision="0" Margin="5,0,0,0"/>
                <TextBlock Text="%" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </StackPanel>
            <GroupBox Header="{lex:Loc StatsItems}" Margin="0,5,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" views:StepScrollAssist.BubbleWheelToParent="True">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding StatisticsItems}" ItemTemplate="{StaticResource StatsItemTemplate}"/>
                    <Expander Header="{lex:Loc StatsCustomConditions}" Margin="0,5,0,0">
                        <StackPanel>
                            <Button Content="+" Command="{Binding AddCustomConditionCommand}" MinWidth="30" HorizontalAlignment="Left" Margin="0,0,0,3"/>
                            <ItemsControl ItemsSource="{Binding CustomConditions}" ItemTemplate="{StaticResource StatsItemTemplate}"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
              </ScrollViewer>
            </GroupBox>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- 烧录配置步骤 -->
    <DataTemplate x:Key="BurnInConfigStepTemplate" DataType="{x:Type AutoVM:BurnInConfigStep}">
        <StackPanel>
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc BurnIn_SelectBurnFinishStep}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding BurnSteps}"
                          SelectedValue="{Binding BurnFinishStepUid}"
                          SelectedValuePath="Uid"
                          MinWidth="180" VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding LineNo, Mode=OneWay}"/>
                                <Run Text=" - "/>
                                <Run Text="{Binding Name, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <TextBlock Text="{lex:Loc BurnIn_FinishStepHint}" Foreground="Gray" FontSize="11" Margin="0,2,0,5" TextWrapping="Wrap"/>
            <!-- 关键字判定（烧录完成步骤为获取输入类型） -->
            <StackPanel Visibility="{Binding ShowKeywordSettings, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <Label Content="{lex:Loc BurnIn_GoodKeywords}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding GoodTextContains, UpdateSourceTrigger=LostFocus}" MinWidth="180"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <Label Content="{lex:Loc BurnIn_BadKeywords}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding BadTextContains, UpdateSourceTrigger=LostFocus}" MinWidth="180"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <Label Content="{lex:Loc BurnIn_FailKeywords}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding FailTextContains, UpdateSourceTrigger=LostFocus}" MinWidth="180"/>
                </StackPanel>
            </StackPanel>
            <!-- 图像判定（烧录完成步骤非获取输入类型时显示，与关键字判定互斥） -->
            <StackPanel Visibility="{Binding ShowImageSettings, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <Label Content="{lex:Loc BurnIn_GoodTemplate}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                    <Button Content="{lex:Loc BurnIn_CropFromScreen}" Command="{Binding SelectTemplateCommand}" CommandParameter="Good" Padding="12,3" VerticalAlignment="Center"/>
                    <Image Source="{Binding GoodTemplateThumb}" MaxHeight="30" Margin="8,0" VerticalAlignment="Center"/>
                    <Button Content="{lex:Loc BurnIn_ClearTemplate}" Command="{Binding ClearTemplateCommand}" CommandParameter="Good" Padding="8,3" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <Label Content="{lex:Loc BurnIn_BadTemplate}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                    <Button Content="{lex:Loc BurnIn_CropFromScreen}" Command="{Binding SelectTemplateCommand}" CommandParameter="Bad" Padding="12,3" VerticalAlignment="Center"/>
                    <Image Source="{Binding BadTemplateThumb}" MaxHeight="30" Margin="8,0" VerticalAlignment="Center"/>
                    <Button Content="{lex:Loc BurnIn_ClearTemplate}" Command="{Binding ClearTemplateCommand}" CommandParameter="Bad" Padding="8,3" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <Label Content="{lex:Loc BurnIn_FailTemplate}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                    <Button Content="{lex:Loc BurnIn_CropFromScreen}" Command="{Binding SelectTemplateCommand}" CommandParameter="Fail" Padding="12,3" VerticalAlignment="Center"/>
                    <Image Source="{Binding FailTemplateThumb}" MaxHeight="30" Margin="8,0" VerticalAlignment="Center"/>
                    <Button Content="{lex:Loc BurnIn_ClearTemplate}" Command="{Binding ClearTemplateCommand}" CommandParameter="Fail" Padding="8,3" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <Label Content="{lex:Loc Picture_similarity_threshold}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                    <wd:NumericBox Value="{Binding SimilarityThreshold}" Width="70" Minimum="0" Maximum="1" Precision="2" Interval="0.01"/>
                </StackPanel>
                <CheckBox IsChecked="{Binding HighPrecision}" Content="{lex:Loc HighPrecision}" ToolTip="{lex:Loc HighPrecision_Hint}" Margin="0,2"/>
                <StackPanel Orientation="Horizontal" Margin="0,2" Visibility="{Binding HighPrecision, Converter={StaticResource BoolToVis}}">
                    <Label Content="{lex:Loc ColorThreshold}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                    <wd:NumericBox Value="{Binding ColorThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Precision="3" Interval="0.001" Width="70" Minimum="0" Maximum="1"/>
                    <Slider Value="{Binding ColorThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1" Width="120" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            <!-- 截图留痕 -->
            <CheckBox IsChecked="{Binding CaptureScreenshot}" Content="{lex:Loc BurnIn_EnableScreenshot}" Margin="0,5,0,2"/>
            <StackPanel Orientation="Horizontal" Margin="0,2"
                        Visibility="{Binding CaptureScreenshot, Converter={StaticResource BoolToVis}}">
                <Label Content="{lex:Loc BurnIn_ScreenshotRegion}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <Button Content="{lex:Loc BurnIn_SelectRegion}" Command="{Binding SelectRegionCommand}" Padding="12,3"/>
                <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Config.RegionRelative}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="X:"/><Run Text="{Binding Config.RegionX, Mode=OneWay, StringFormat=F0}"/>
                    <Run Text=" Y:"/><Run Text="{Binding Config.RegionY, Mode=OneWay, StringFormat=F0}"/>
                    <Run Text=" W:"/><Run Text="{Binding Config.RegionW, Mode=OneWay, StringFormat=F0}"/>
                    <Run Text=" H:"/><Run Text="{Binding Config.RegionH, Mode=OneWay, StringFormat=F0}"/>
                </TextBlock>
            </StackPanel>
            <!-- 屏幕相对坐标：按主屏宽/高的百分比（0~100），两位小数 -->
            <StackPanel Orientation="Horizontal" Margin="0,2"
                        Visibility="{Binding CaptureScreenshot, Converter={StaticResource BoolToVis}}">
                <CheckBox IsChecked="{Binding Config.RegionRelative}" Content="{lex:Loc Coordinate_ScreenRelative}" ToolTip="{lex:Loc Coordinate_ScreenRelative_Hint}" VerticalAlignment="Center"/>
                <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray"
                            Visibility="{Binding Config.RegionRelative, Converter={StaticResource BoolToVis}}">
                    <Run Text="X:"/><Run Text="{Binding Config.RegionX, Mode=OneWay, StringFormat=F2}"/>
                    <Run Text=" Y:"/><Run Text="{Binding Config.RegionY, Mode=OneWay, StringFormat=F2}"/>
                    <Run Text=" W:"/><Run Text="{Binding Config.RegionW, Mode=OneWay, StringFormat=F2}"/>
                    <Run Text=" H:"/><Run Text="{Binding Config.RegionH, Mode=OneWay, StringFormat=F2}"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,2"
                        Visibility="{Binding CaptureScreenshot, Converter={StaticResource BoolToVis}}">
                <Label Content="{lex:Loc BurnIn_ScreenshotDir}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding ScreenshotDir, UpdateSourceTrigger=LostFocus}" MinWidth="150" VerticalAlignment="Center"
                         ToolTip="{lex:Loc BurnIn_ScreenshotDirHint}"/>
                <Button Content="{lex:Loc Select}" Command="{Binding BrowseScreenshotDirCommand}" Margin="3,0,0,0" Padding="12,3"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="18,2,0,2"
                        Visibility="{Binding CaptureScreenshot, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding EffectiveScreenshotDir, Mode=OneWay}" Foreground="Gray" FontSize="11"
                           ToolTip="{lex:Loc BurnIn_ScreenshotDirHint}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc WaitTime}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WaitTime}" Width="70" Minimum="0" Precision="3" Interval="0.01"/>
            </StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- 窗口聚焦步骤 -->
    <DataTemplate x:Key="FocusWindowStepTemplate" DataType="{x:Type AutoVM:FocusWindowStep}">
        <StackPanel>
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Focus_SelectedWindow}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding WindowTitles}" SelectedItem="{Binding SelectedWindowTitle}" MinWidth="240" VerticalContentAlignment="Center"/>
                <Button Content="{lex:Loc Focus_Refresh}" Command="{Binding RefreshWindowsCommand}" Margin="5,0,0,0" Padding="12,3"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Focus_Keyword}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding WindowTitleKeyword, UpdateSourceTrigger=LostFocus}" MinWidth="180"/>
            </StackPanel>
            <TextBlock Text="{lex:Loc Focus_Hint}" Foreground="Gray" FontSize="11" Margin="0,2,0,5" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc WaitTime}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding WaitTime}" Width="70" Minimum="0" Precision="3" Interval="0.01"/>
            </StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionEntryTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- 多线程开始步骤 -->
    <DataTemplate x:Key="MultiThreadStartTemplate" DataType="{x:Type AutoVM:MultiThreadStartStep}">
        <StackPanel>
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc MT_ThreadCount}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding ThreadCount, Mode=TwoWay}" Width="80" Minimum="1" Precision="0"
                               ToolTip="{lex:Loc MT_ThreadCountHint}"/>
                <TextBlock Text="{lex:Loc MT_ThreadCountHint}" Foreground="Gray" FontSize="11" Margin="8,0,0,0"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc MT_RangeMode}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Source={x:Static AutoVM:MultiThreadStartStep.RangeModes}}"
                          SelectedItem="{Binding RangeMode}" MinWidth="170" VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource ConditionEnumToString}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <!-- 仅「按结束步骤选择」方式需要指定结束步骤 -->
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RangeMode}" Value="{x:Static AutoVM:MultiThreadRangeMode.ByLineNo}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Label Content="{lex:Loc MT_RangeEnd}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding AllSteps}"
                          SelectedValue="{Binding RangeEndUid, TargetNullValue={x:Static sys:Guid.Empty}}"
                          SelectedValuePath="Uid"
                          IsEditable="False"
                          MinWidth="180" VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding LineNo, Mode=OneWay}"/>
                                <Run Text=" - "/>
                                <Run Text="{Binding Name, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{lex:Loc MT_RangeEnd_ToEnd}" Foreground="Gray" FontSize="11" Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionEntryTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- 多线程区域结束步骤（纯区域标记，本身不执行动作） -->
    <DataTemplate x:Key="MultiThreadEndTemplate" DataType="{x:Type AutoVM:MultiThreadEndStep}">
        <StackPanel>
            <TextBlock Text="{lex:Loc MT_EndHint}" Foreground="Gray" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionEntryTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- 发出信号步骤 -->
    <DataTemplate x:Key="SendSignalTemplate" DataType="{x:Type AutoVM:SendSignalStep}">
        <StackPanel>
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Signal_Name}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding SignalName, UpdateSourceTrigger=LostFocus}" MinWidth="180"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Signal_Kind}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Source={x:Static AutoVM:SendSignalStep.SignalKinds}}"
                          SelectedItem="{Binding SignalKind}" MinWidth="120" VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource ConditionEnumToString}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <!-- 信号值：按信号类型切显隐 -->
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Signal_Value}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SignalKind}" Value="{x:Static svc:SignalValueKind.Bool}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <CheckBox IsChecked="{Binding SignalBool}" Content="{lex:Loc Signal_Kind_Bool}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SignalKind}" Value="{x:Static svc:SignalValueKind.Int}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <wd:NumericBox Value="{Binding SignalInt, Mode=TwoWay}" Width="90" Precision="0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SignalKind}" Value="{x:Static svc:SignalValueKind.String}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBox Text="{Binding SignalString, UpdateSourceTrigger=LostFocus}" MinWidth="180"/>
                </StackPanel>
            </StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionEntryTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- 接收信号步骤 -->
    <DataTemplate x:Key="ReceiveSignalTemplate" DataType="{x:Type AutoVM:ReceiveSignalStep}">
        <StackPanel>
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Signal_Name}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding SignalName, UpdateSourceTrigger=LostFocus}" MinWidth="180"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Signal_Kind}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Source={x:Static AutoVM:ReceiveSignalStep.SignalKinds}}"
                          SelectedItem="{Binding SignalKind}" MinWidth="120" VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource ConditionEnumToString}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <CheckBox IsChecked="{Binding Blocking}" Content="{lex:Loc Signal_Blocking}"
                      ToolTip="{lex:Loc Signal_BlockingHint}" Margin="0,2"/>
            <!-- 等待超时：仅阻塞等待时有效 -->
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Blocking}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Label Content="{lex:Loc Signal_Timeout}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <wd:NumericBox Value="{Binding SignalTimeout, Mode=TwoWay}" Width="80" Minimum="0" Precision="1"/>
                <TextBlock Text="{lex:Loc Signal_Timeout_Unlimited}" Foreground="Gray" FontSize="11" Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionEntryTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- 中断步骤（仅子线程可用） -->
    <DataTemplate x:Key="InterruptTemplate" DataType="{x:Type AutoVM:InterruptStep}">
        <StackPanel>
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc Interrupt_Target}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding AllSteps}"
                          SelectedValue="{Binding InterruptTargetUid, TargetNullValue={x:Static sys:Guid.Empty}}"
                          SelectedValuePath="Uid"
                          IsEditable="False"
                          MinWidth="200" VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding LineNo, Mode=OneWay}"/>
                                <Run Text=" - "/>
                                <Run Text="{Binding Name, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <TextBlock Text="{lex:Loc Interrupt_Hint}" Foreground="Gray" FontSize="11" Margin="0,2,0,5" TextWrapping="Wrap"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionEntryTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- 上传Acbel：引用菜单样式（引用步骤 -> 步骤 -> 结果种类，以及清除引用） -->
    <Style x:Key="AcbelRefLeafStyle" TargetType="{x:Type MenuItem}">
        <Setter Property="Command" Value="{Binding Command}"/>
    </Style>

    <Style x:Key="AcbelRefStepStyle" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource AcbelRefLeafStyle}">
        <Setter Property="ItemsSource" Value="{Binding Children}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource AcbelRefLeafStyle}"/>
    </Style>

    <Style x:Key="AcbelRefRootStyle" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource AcbelRefLeafStyle}">
        <Setter Property="ItemsSource" Value="{Binding Children}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource AcbelRefStepStyle}"/>
    </Style>

    <!-- 上传Acbel：字段行（段名 + 固定文本输入框 / 引用标签 + ▾ 引用菜单） -->
    <DataTemplate x:Key="AcbelUploadRowTemplate" DataType="{x:Type AutoVM:AcbelUploadRow}">
        <Grid Margin="0,0,0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                <TextBlock Text="{lex:Loc AcbelRequiredMark}" Foreground="#FFD32F2F" FontWeight="Bold" FontSize="11"
                           Margin="0,0,3,0" VerticalAlignment="Center"
                           Visibility="{Binding IsRequired, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
            </StackPanel>
            <Grid Grid.Column="1">
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center">
                    <TextBox.Style>
                        <Style TargetType="{x:Type TextBox}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReferenced}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Button Command="{Binding ClearReferenceCommand}" ToolTip="{Binding ReferenceLabel}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="#FFF0F6FC" BorderBrush="#FFB8CBE0" BorderThickness="1"
                                                CornerRadius="2" Padding="4,1">
                                            <TextBlock Text="{Binding ReferenceLabel}" Foreground="#FF1E6FB8" FontSize="11"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReferenced}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            <Menu Grid.Column="2" Background="Transparent" VerticalAlignment="Center" Padding="0">
                <MenuItem Header="▾" Padding="4,1" ItemsSource="{Binding MenuNodes}"
                          ItemContainerStyle="{StaticResource AcbelRefRootStyle}"/>
            </Menu>
        </Grid>
    </DataTemplate>

    <!-- 上传Acbel：ACBEL_INSERT_DATA 上传步骤 -->
    <DataTemplate x:Key="AcbelUploadStepTemplate" DataType="{x:Type AutoVM:AcbelUploadStep}">
        <StackPanel>
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <CheckBox IsChecked="{Binding DryRun}" Content="{lex:Loc AcbelDryRun}" Margin="0,0,0,5"/>
            <TextBlock Text="{lex:Loc AcbelProgramFile}" FontWeight="Bold" Margin="0,0,0,2"/>
            <ContentControl Content="{Binding ProgramFileRow}" ContentTemplate="{StaticResource AcbelUploadRowTemplate}"/>
            <Separator Margin="0,5"/>
            <ItemsControl ItemsSource="{Binding RequiredRows}" ItemTemplate="{StaticResource AcbelUploadRowTemplate}"/>
            <Expander Margin="0,6,0,0">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{lex:Loc AcbelOptionalFields}"/>
                        <TextBlock Text="{Binding OptionalRows.Count}" Margin="4,0,0,0"/>
                    </StackPanel>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding OptionalRows}" ItemTemplate="{StaticResource AcbelUploadRowTemplate}"/>
            </Expander>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionEntryTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- 用户输入步骤：打开工程 / 开始运行前弹窗填写字段，字段值可被其他步骤按名称引用 -->
    <DataTemplate x:Key="UserInputStepTemplate" DataType="{x:Type AutoVM:UserInputStep}">
        <StackPanel>
            <CheckBox IsChecked="{Binding EnableLog}" Content="{lex:Loc EnableLog}" Margin="0,0,0,5"/>
            <!-- 弹窗标题（留空时占位显示「用户输入」） -->
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="{lex:Loc UserInput_Title}" Padding="0,0,5,0" VerticalAlignment="Center"/>
                <Grid MinWidth="180">
                    <TextBox Text="{Binding PromptTitle, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                    <TextBlock Text="{lex:Loc UserInput_Title}" Foreground="Gray" Margin="4,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PromptTitle}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PromptTitle}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
            <!-- 询问时机（可同时勾选：打开工程时 / 开始运行前） -->
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <CheckBox IsChecked="{Binding AskOnFileOpen}" Content="{lex:Loc UserInput_AskOnOpen}"
                          VerticalAlignment="Center" Margin="0,0,15,0"/>
                <CheckBox IsChecked="{Binding AskOnRun}" Content="{lex:Loc UserInput_AskOnRun}"
                          VerticalAlignment="Center"/>
            </StackPanel>
            <!-- 冻结字段说明：首次填写确认后锁定，登录后才可修改 -->
            <TextBlock Text="{lex:Loc UserInput_FrozenHint}" Foreground="Gray" FontSize="11"
                       TextWrapping="Wrap" Margin="0,2,0,0"/>
            <GroupBox Header="{lex:Loc UserInput_Fields}" Margin="0,6,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" views:StepScrollAssist.BubbleWheelToParent="True">
                <StackPanel>
                    <DataGrid x:Name="UserInputFieldsGrid" ItemsSource="{Binding Fields}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal" SelectionMode="Single" SelectionUnit="FullRow"
                              IsReadOnly="True" Height="Auto" MaxHeight="240"
                              Background="Transparent" AlternatingRowBackground="#F5F5F5"
                              views:UserInputFieldLockGuard.GuardLockedEdits="True">
                        <DataGrid.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}">
                                <Setter Property="Padding" Value="2,1"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{lex:Loc UserInput_FieldName}" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent" MinHeight="22"
                                                 VerticalContentAlignment="Center" ToolTip="{Binding Name}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{lex:Loc UserInput_FieldType}" Width="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Source={x:Static models:UserInputField.AllTypes}}"
                                                  SelectedItem="{Binding FieldType, UpdateSourceTrigger=PropertyChanged}"
                                                  MinHeight="22" BorderThickness="0" Background="Transparent">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding}" Value="{x:Static models:UserInputFieldType.Text}">
                                                                        <Setter Property="Text" Value="{lex:Loc UserInput_Type_Text}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding}" Value="{x:Static models:UserInputFieldType.Number}">
                                                                        <Setter Property="Text" Value="{lex:Loc UserInput_Type_Number}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding}" Value="{x:Static models:UserInputFieldType.Date}">
                                                                        <Setter Property="Text" Value="{lex:Loc UserInput_Type_Date}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding}" Value="{x:Static models:UserInputFieldType.Password}">
                                                                        <Setter Property="Text" Value="{lex:Loc UserInput_Type_Password}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding}" Value="{x:Static models:UserInputFieldType.Dropdown}">
                                                                        <Setter Property="Text" Value="{lex:Loc UserInput_Type_Dropdown}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- 值：冻结且已确认、未登录时只读（灰色 + 提示登录后修改） -->
                            <DataGridTemplateColumn Header="{lex:Loc UserInput_FieldValue}" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="22" VerticalContentAlignment="Center"
                                                 views:UserInputFieldLockGuard.GuardLockedValue="True">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="ToolTip" Value="{Binding Value}"/>
                                                    <Setter Property="IsReadOnly"
                                                            Value="{Binding CanEditValue, Converter={StaticResource BoolToInverse}}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsValueLocked}" Value="True">
                                                            <Setter Property="Background" Value="#FFF0F0F0"/>
                                                            <Setter Property="Foreground" Value="#FF808080"/>
                                                            <Setter Property="ToolTip" Value="{lex:Loc UserInput_FrozenLocked}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{lex:Loc UserInput_Required}" Width="42">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsRequired}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- 冻结：勾选后该字段首次确认填写即锁定，修改需要登录 -->
                            <DataGridTemplateColumn Header="{lex:Loc UserInput_Frozen}" Width="46">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsFrozen, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  ToolTip="{lex:Loc UserInput_FrozenHint}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{lex:Loc UserInput_Options}" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Options, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent" MinHeight="22" MaxHeight="60"
                                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top"
                                                 IsEnabled="{Binding IsDropdown}"
                                                 ToolTip="{lex:Loc UserInput_Options_Hint}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{lex:Loc UserInput_Description}" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent" MinHeight="22"
                                                 VerticalContentAlignment="Center" ToolTip="{Binding Description}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="{lex:Loc UserInput_AddField}" Command="{Binding AddFieldCommand}" Margin="0,0,5,0"/>
                        <Button Content="{lex:Loc UserInput_RemoveField}" Command="{Binding RemoveFieldCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=UserInputFieldsGrid}" Margin="0,0,5,0"/>
                        <Button Content="{lex:Loc UserInput_FillNow}" Command="{Binding AskNowCommand}"/>
                    </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </GroupBox>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GotoPanelTemplate}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionEntryTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <conv:StepTemplateSelector x:Key="StepDetailSelector"
                     EmptyStepTemplate="{StaticResource EmptyStepTemplate}"
                     ClickImageTemplate="{StaticResource ClickImageStepTemplate}"
                     FindImageTemplate="{StaticResource FindImageStepTemplate}"
                     TypeTextTemplate="{StaticResource TextStepTemplate}"
                     TypeTextMoreTemplate="{StaticResource TextStepMoreTemplate}"
                     TypeTextFromFileTemplate="{StaticResource TextStepFromFileTemplate}"
                     PopupTemplate="{StaticResource PopupStepTemplate}"
                     AcbelUploadTemplate="{StaticResource AcbelUploadStepTemplate}"
                     GetInputTemplate="{StaticResource GetInputStepTemplate}"
                     MouseActionTemplate="{StaticResource MouseActionStepTemplate}"
                     StatisticsTemplate="{StaticResource StatisticsStepTemplate}"
                     BurnInConfigTemplate="{StaticResource BurnInConfigStepTemplate}"
                     FocusWindowTemplate="{StaticResource FocusWindowStepTemplate}"
                     MultiThreadTemplate="{StaticResource MultiThreadStartTemplate}"
                     MultiThreadEndTemplate="{StaticResource MultiThreadEndTemplate}"
                     SendSignalTemplate="{StaticResource SendSignalTemplate}"
                     ReceiveSignalTemplate="{StaticResource ReceiveSignalTemplate}"
                     InterruptTemplate="{StaticResource InterruptTemplate}"
                     UserInputTemplate="{StaticResource UserInputStepTemplate}"/>
</ResourceDictionary>