<Window x:Class="ShaoLu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wd="https://github.com/WPFDevelopersOrg/WPFDevelopers"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:ResxLocalizationProvider.DefaultAssembly="ShaoLu"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        xmlns:local="clr-namespace:ShaoLu"
        xmlns:view="clr-namespace:ShaoLu.Views"
        xmlns:viewmodel="clr-namespace:ShaoLu.Viewmodels"
        xmlns:conv="clr-namespace:ShaoLu.Converters"
        d:DataContext="{d:DesignInstance Type=viewmodel:MainViewModel}"
        mc:Ignorable="d"
        Title="{lex:Loc AppTitle}" Height="600" Width="1000">

    <!-- 文件操作快捷键（仅主窗口内有效） -->
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{x:Static local:MainWindow.NewCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{x:Static local:MainWindow.OpenCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{x:Static local:MainWindow.SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{x:Static local:MainWindow.SaveAsCommand}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.NewCommand}" Executed="New_Click"/>
        <CommandBinding Command="{x:Static local:MainWindow.OpenCommand}" Executed="Open_Click"/>
        <CommandBinding Command="{x:Static local:MainWindow.SaveCommand}" Executed="Save_Click"/>
        <CommandBinding Command="{x:Static local:MainWindow.SaveAsCommand}" Executed="SaveAs_Click"/>
    </Window.CommandBindings>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Menu>
            <MenuItem x:Name="File" Header="{lex:Loc}">
                <MenuItem x:Name="New" Header="{lex:Loc}" Click="New_Click" IsEnabled="{Binding IsLoggedIn}" InputGestureText="Ctrl+N"/>
                <MenuItem x:Name="Open" Header="{lex:Loc}" Click="Open_Click" InputGestureText="Ctrl+O"/>
                <MenuItem x:Name="Save" Header="{lex:Loc Save}" Click="Save_Click" IsEnabled="{Binding IsLoggedIn}" InputGestureText="Ctrl+S"/>
                <MenuItem x:Name="SaveAs" Header="{lex:Loc SaveAs}" Click="SaveAs_Click" IsEnabled="{Binding IsLoggedIn}" InputGestureText="Ctrl+Shift+S"/>
            </MenuItem>
            <MenuItem x:Name="Setting" Header="{lex:Loc}" Click="Setting_Click">
            </MenuItem>
            <MenuItem x:Name="EditMenu" Header="{lex:Loc Edit}">
                <MenuItem x:Name="LoginLogout" Header="{lex:Loc Menu_Login}" Click="LoginLogout_Click"/>
                <MenuItem x:Name="UserManagement" Header="{lex:Loc UserManagementTitle}" Click="UserManagement_Click"
                          IsEnabled="{Binding IsLoggedIn}"/>
            </MenuItem>
            <MenuItem x:Name="ExecutionLog" Header="{lex:Loc}" Click="ExecutionLog_Click"/>
            <MenuItem x:Name="BurnInStatistics" Header="{lex:Loc}" Click="BurnInStatistics_Click"/>
            <MenuItem x:Name="Language" Header="{lex:Loc}">
                <MenuItem x:Name="English" Tag="en-US"  Header="{lex:Loc}" IsChecked="{Binding English}" Click="Language_Click"/>
                <MenuItem x:Name="SimplifiedChinese" Tag="zh-CN" Header="{lex:Loc}" IsChecked="{Binding Simplified}" Click="Language_Click"/>
                <MenuItem x:Name="TraditionalChinese" Tag="zh-TW" Header="{lex:Loc}" IsChecked="{Binding Tranditional}" Click="Language_Click"/>
            </MenuItem>
            <MenuItem x:Name="About" Header="{lex:Loc}" Click="About_Click"/>
            <MenuItem x:Name="Quit" Header="{lex:Loc}" Click="Quit_Click"/>
            <!--<MenuItem Header="测试裁剪" Click="TestCrop_Click"/>-->
        </Menu> <!--菜单-->
        <view:UserControlSteps Grid.Row="1" x:Name="Steps"/>
    </Grid>
</Window>
