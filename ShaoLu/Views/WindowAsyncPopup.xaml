<Window x:Class="ShaoLu.Views.WindowAsyncPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MinWidth="120" MinHeight="140"
        MaxWidth="400" MaxHeight="400"
        Background="{DynamicResource WD.BackgroundBrush}">
    <!-- 原生窗口：标题栏自带最小化/最大化/关闭与拖拽；正文区是唯一滚动宿主，按钮区不参与压缩 -->
    <Grid x:Name="LayoutRoot" Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="BodyHost" Grid.Row="0" MinHeight="21">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="IconImage"
                   Grid.Column="0"
                   Width="40" Height="40"
                   Margin="0,0,16,0"
                   VerticalAlignment="Top"/>
            <FlowDocumentScrollViewer x:Name="MessageViewer" Grid.Column="1"
                                      IsToolBarVisible="False" IsTabStop="False"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"/>
        </Grid>

        <ScrollViewer x:Name="ButtonHost" Grid.Row="1" Margin="0,16,0,0" MaxHeight="72"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="ButtonPanel"
                       Orientation="Horizontal"
                       HorizontalAlignment="Right"
                       ItemHeight="32"/>
        </ScrollViewer>
    </Grid>
</Window>
