<Window x:Class="ShaoLu.Views.WindowTextInput"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        MinWidth="320" MaxWidth="520"
        Background="{DynamicResource WD.BackgroundBrush}"
        Title="Rename">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBox x:Name="ValueBox" Grid.Row="1" Padding="6,4" MinWidth="280"
                 KeyDown="ValueBox_KeyDown"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" x:Name="OkButton" MinWidth="80" Height="30" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" x:Name="CancelButton" MinWidth="80" Height="30" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
