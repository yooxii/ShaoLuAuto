<UserControl x:Class="ShaoLu.Views.UserControlSteps"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:lex="http://wpflocalizeextension.codeplex.com"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:wd="https://github.com/WPFDevelopersOrg/WPFDevelopers"
            lex:ResxLocalizationProvider.DefaultAssembly="ShaoLu"
            lex:ResxLocalizationProvider.DefaultDictionary="Strings"
            xmlns:local="clr-namespace:ShaoLu"
            xmlns:utils="clr-namespace:ShaoLu.Utils"
            xmlns:viewmodel="clr-namespace:ShaoLu.Viewmodels"
            xmlns:conv="clr-namespace:ShaoLu.Converters"
            d:DataContext="{d:DesignInstance Type=viewmodel:StepsViewModel}"
            mc:Ignorable="d"
            d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:BoolToInverseBoolConverter x:Key="BoolToInverseBoolConverter"/>
            <utils:SingletonLocator x:Key="VMLocator" />

            <ContextMenu x:Key="DataGridMenu" DataContext="{Binding Steps, Source={StaticResource VMLocator}}">
                <MenuItem Header="{lex:Loc Add}">
                    <MenuItem Header="{lex:Loc AddImageStep}" Command="{Binding AddStepCommand}" CommandParameter="ClickImage"/>
                    <MenuItem Header="{lex:Loc AddFindImageStep}" Command="{Binding AddStepCommand}" CommandParameter="FindImage"/>
                    <MenuItem Header="{lex:Loc AddImagesStep}" Command="{Binding AddStepCommand}" CommandParameter="ClickImages"/>
                    <MenuItem Header="{lex:Loc AddFindImagesStep}" Command="{Binding AddStepCommand}" CommandParameter="FindImages"/>
                    <MenuItem Header="{lex:Loc AddTextStep}" Command="{Binding AddStepCommand}" CommandParameter="TypeText"/>
                    <MenuItem Header="{lex:Loc AddTextMoreStep}" Command="{Binding AddStepCommand}" CommandParameter="TypeTextMore"/>
                    <MenuItem Header="{lex:Loc AddTextFromFileStep}" Command="{Binding AddStepCommand}" CommandParameter="TypeTextFromFile"/>
                    <MenuItem Header="{lex:Loc AddPopupStep}" Command="{Binding AddStepCommand}" CommandParameter="Popup"/>
                    <MenuItem Header="{lex:Loc AddTextOCRStep}" Command="{Binding AddStepCommand}" CommandParameter="TextOCR"/>
                </MenuItem>
                <MenuItem Header="{lex:Loc Delete}" Command="{Binding DelStepCommand}"/>
                <Separator/>
                <MenuItem Header="{lex:Loc Up}" Command="{Binding UpStepCommand}"/>
                <MenuItem Header="{lex:Loc Down}" Command="{Binding DownStepCommand}"/>
                <MenuItem Header="{lex:Loc Select}" Command="{Binding SelectStepCommand}"/>
                <Separator/>
                <MenuItem Header="{lex:Loc Copy}" Command="{Binding CopyStepCommand}"/>
                <MenuItem Header="{lex:Loc Cut}" Command="{Binding CutStepCommand}"/>
                <MenuItem Header="{lex:Loc Paste}" Command="{Binding PasteStepCommand}"/>
            </ContextMenu>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Templates/StepDetailTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <ToolBarPanel Margin="3">
                <ToolBarTray Orientation="Horizontal">
                    <ToolBar>
                        <Button Content="{lex:Loc BtnRun_Content}" Margin="3" Command="{Binding RunCommand}"/>
                        <Button Content="{lex:Loc BtnStop_Content}" Margin="3" Command="{Binding StopCommand}"/>
                    </ToolBar>
                    <ToolBar Header="{lex:Loc Edit}" IsEnabled="{Binding Main.IsLoggedIn, Source={StaticResource VMLocator}}">
                        <Button Content="{lex:Loc Refresh}" Margin="3" Click="Refresh_Click"/>
                        <Button Content="{lex:Loc Up}" Margin="3" Command="{Binding UpStepCommand}"/>
                        <Button Content="{lex:Loc Down}" Margin="3" Command="{Binding DownStepCommand}"/>
                        <Button Content="{lex:Loc Copy}" Margin="3" Command="{Binding CopyStepCommand}"/>
                        <Button Content="{lex:Loc Cut}" Margin="3" Command="{Binding CutStepCommand}"/>
                        <Button Content="{lex:Loc Paste}" Margin="3" Command="{Binding PasteStepCommand}"/>
                        <Button Content="{lex:Loc Delete}" Margin="3" Command="{Binding DelStepCommand}"/>
                    </ToolBar>
                    <ToolBar Header="{lex:Loc Step}" IsEnabled="{Binding Main.IsLoggedIn, Source={StaticResource VMLocator}}">
                        <wd:SplitButton x:Name="AddImageStep" Content="{lex:Loc AddImageStep}" CommandParameter="ClickImage" Margin="3" Background="Transparent" Foreground="Black" BorderBrush="Transparent" BorderThickness="0" Click="SplitButton_Click"
                                       >
                            <MenuItem Header="{lex:Loc AddImageStep}" Click="MenuItemAddImageStep_Click" CommandParameter="ClickImage"/>
                            <MenuItem Header="{lex:Loc AddFindImageStep}" Click="MenuItemAddImageStep_Click" CommandParameter="FindImage"/>
                            <MenuItem Header="{lex:Loc AddImagesStep}" Click="MenuItemAddImageStep_Click" CommandParameter="ClickImages"/>
                            <MenuItem Header="{lex:Loc AddFindImagesStep}" Click="MenuItemAddImageStep_Click" CommandParameter="FindImages"/>
                        </wd:SplitButton>
                        <wd:SplitButton x:Name="AddTextStep" Content="{lex:Loc AddTextStep}" CommandParameter="TypeText" Margin="3" Background="Transparent" Foreground="Black" BorderBrush="Transparent" BorderThickness="0" Click="SplitButton_Click"
                                       >
                            <MenuItem Header="{lex:Loc AddTextStep}" Margin="3" Click="MenuItemAddTextStep_Click" CommandParameter="TypeText"/>
                            <MenuItem Header="{lex:Loc AddTextMoreStep}" Margin="3" Click="MenuItemAddTextStep_Click" CommandParameter="TypeTextMore"/>
                            <MenuItem Header="{lex:Loc AddTextFromFileStep}" Margin="3" Click="MenuItemAddTextStep_Click" CommandParameter="TypeTextFromFile"/>
                        </wd:SplitButton>
                        <Button Content="{lex:Loc AddPopupStep}" Margin="3" Command="{Binding AddStepCommand}" CommandParameter="Popup"
                               />
                        <Button Content="{lex:Loc AddTextOCRStep}" Margin="3" Command="{Binding AddStepCommand}" CommandParameter="TextOCR"
                               />
                    </ToolBar>
                </ToolBarTray>
            </ToolBarPanel>
            <!--步骤按钮-->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="400"/>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="Auto" MinWidth="255"/>
                </Grid.ColumnDefinitions>
                <GroupBox Header="{lex:Loc StepsBox}" Margin="3">
                    <DataGrid x:Name="StepsBox" ItemsSource="{Binding AutomationStepBases}"
                              ContextMenu="{StaticResource DataGridMenu}"
                              SelectionMode="Extended" SelectedItem="{Binding SelectedStep}"
                              utils:DataGridSelectedItemsBehavior.SelectedItems="{Binding SelectedSteps}"
                              IsReadOnly="{Binding Main.IsLoggedIn, Source={StaticResource VMLocator}, Converter={StaticResource BoolToInverseBoolConverter}}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Setters>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Style.Setters>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Background" Value="#FFFFCCCC"/>
                                        <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderBrush" Value="Black"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding IsNeed,UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="" Binding="{Binding LineNo}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="{lex:Loc StepType}" Binding="{Binding Type}" IsReadOnly="True" CanUserSort="False"/>
                            <DataGridTextColumn Header="{lex:Loc StepName}" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="120" CanUserSort="False"/>
                            <DataGridTextColumn Header="{lex:Loc StepDescription}" Binding="{Binding Description}" Width="*" CanUserSort="False"/>
                            <DataGridTextColumn Header="{lex:Loc StepTrueGoto}" Binding="{Binding TrueGoto, UpdateSourceTrigger=LostFocus}" Width="*" CanUserSort="False"/>
                            <DataGridTextColumn Header="{lex:Loc StepFalseGoto}" Binding="{Binding FalseGoto, UpdateSourceTrigger=LostFocus}" Width="*" CanUserSort="False"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
                <GridSplitter Grid.Column="1" Width="3" Margin="0,3,0,3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#FFDDDDDD" />
                <GroupBox Header="{lex:Loc StepDetails}" Margin="3" Grid.Column="2"
                          IsEnabled="{Binding Main.IsLoggedIn, Source={StaticResource VMLocator}}">
                    <!-- 当 SelectedStep 为 null 时，可以显示提示文本 -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch">
                        <Grid>
                            <ContentControl Content="{Binding SelectedStep}" 
                        ContentTemplateSelector="{StaticResource StepDetailSelector}" />

                            <!-- 可选：如果没有选中项，显示提示信息 -->
                            <TextBlock Text="{lex:Loc NoSelectionHint}" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            Visibility="{Binding SelectedStep, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}"/>
                        </Grid>
                    </ScrollViewer>
                </GroupBox>
            </Grid>
            <Grid Grid.Row="2" Margin="3 0 3 5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnRun" Content="{lex:Loc}" Margin="0,3,3,3" Command="{Binding RunCommand}"/>
                <Button x:Name="BtnStop" Grid.Column="1" Content="{lex:Loc}" Margin="3,3,0,3" Command="{Binding StopCommand}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
