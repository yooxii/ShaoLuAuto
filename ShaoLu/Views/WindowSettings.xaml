<Window x:Class="ShaoLu.Views.WindowSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        xmlns:local="clr-namespace:ShaoLu.Views"
        xmlns:conv="clr-namespace:ShaoLu.Converters"
        xmlns:vm="clr-namespace:ShaoLu.Viewmodels"
        xmlns:models="clr-namespace:ShaoLu.Models"
        xmlns:wd="https://github.com/WPFDevelopersOrg/WPFDevelopers"
        d:DataContext="{d:DesignInstance Type=vm:SettingsWindowViewModel}"
        mc:Ignorable="d"
        Title="{lex:Loc Settings}" Height="500" Width="850">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Templates/SettingsTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 左侧：TreeView 导航 -->
        <TreeView Grid.Column="0" Grid.RowSpan="2"
                  ItemsSource="{Binding Categories}"
                  SelectedItemChanged="TreeView_SelectedItemChanged"
                  BorderThickness="0,0,1,0">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="Padding" Value="4,3"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type vm:SettingsCategory}"
                                          ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Title}" Margin="2,1"/>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- 右侧：可滚动设置面板 -->
        <ScrollViewer x:Name="SettingsScroll" 
                      Grid.Column="1" Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      Padding="16,12">
            <StackPanel x:Name="SettingsPanel">
                <!-- App 设置区域 -->
                <ContentControl Content="{Binding Categories[0].ViewModel}"/>
                
                <!-- 分隔线 -->
                <Separator Margin="0,16"/>
                
                <!-- Step 设置区域 -->
                <ContentControl Content="{Binding Categories[1].ViewModel}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="16">
            <Button Content="{lex:Loc Save}" Command="{Binding SaveCommand}"
                    Width="80" Height="30" Margin="0,0,8,0"/>
            <Button Content="{lex:Loc Cancel}" Click="Cancel_Click" 
                    Width="80" Height="30"/>
        </StackPanel>
    </Grid>
</Window>
